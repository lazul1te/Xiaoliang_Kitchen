/**app.wxss** 全局样式。主题色取自头像，见 design/brand.md */
page {
  --yolk: #ffb21e; /* 主色：按钮、选中、点菜 +。黄底上一律用深色字 */
  --pan: #3b3b42; /* 深色：正文、底部点菜栏 */
  --apricot: #ffe7c2; /* 浅色：占位图、标签底 */
  --cream: #fff8ee; /* 页面背景 */
  --scallion: #5db15a; /* 完成 / 已买 */
  --wood: #a0693f; /* 木柄棕：次要强调 */
  --text-2: #6e6e76; /* 次要文字 */
  --text-3: #a0a0a8; /* 提示文字 */
  --line: #f2e8da; /* 分隔线 */
  --danger: #e5534b; /* 删除 */

  /* 字号：统一用这几档 */
  --fs-xl: 40rpx; /* 大数字 */
  --fs-lg: 32rpx; /* 空状态标题 */
  --fs-title: 30rpx; /* 卡片标题、菜名 */
  --fs-body: 28rpx; /* 正文 */
  --fs-sub: 26rpx; /* 说明文字 */
  --fs-small: 24rpx; /* 辅助文字、小按钮 */
  --fs-tiny: 22rpx; /* 角标、标签 */

  background: var(--cream);
  color: var(--pan);
  font-size: 28rpx;
  line-height: 1.5;
}

view,
scroll-view,
input,
image {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* ---------- 通用 ---------- */

.card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.card-title {
  margin-bottom: 16rpx;
  font-size: var(--fs-title);
  font-weight: 700;
}

/* 说明文字、小提示、「还没有……」：各页统一用这几个 */
.para {
  font-size: var(--fs-sub);
  line-height: 1.7;
  color: var(--text-2);
}

.hint {
  font-size: var(--fs-small);
  line-height: 1.6;
  color: var(--text-3);
}

.none {
  font-size: var(--fs-sub);
  color: var(--text-3);
}

/* 线条小图标（images/icons，源文件在 design/icons），跟在文字前面 */
.ic {
  display: inline-block;
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  vertical-align: -6rpx;
}

.ic.sm {
  width: 28rpx;
  height: 28rpx;
  vertical-align: -4rpx;
}

.ic.lg {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  vertical-align: -12rpx;
}

.ic.xl {
  width: 64rpx;
  height: 64rpx;
  margin: 0 0 8rpx;
}

/* 看着小的按钮：能点的范围往外扩一圈，手指好按（和加减号一样的做法）。
   只加在没有绝对定位、没用 ::after 的元素上 */
.hit {
  position: relative;
}

.hit::after {
  content: "";
  position: absolute;
  top: -20rpx;
  right: -16rpx;
  bottom: -20rpx;
  left: -16rpx;
}

/* ---------- 按下去的样子（能点的 view 都加了 hover-class） ---------- */
/* 按钮、选项、小图标：按下变淡 */
.tap {
  opacity: 0.6;
  transition: opacity 0.1s;
}

/* 列表里的一行：按下底色深一点 */
.tap-row {
  background-color: rgba(59, 59, 66, 0.06);
  transition: background-color 0.1s;
}

/* 整张卡片：按下轻轻缩一下 */
.tap-card {
  opacity: 0.88;
  transform: scale(0.98);
  transition: transform 0.12s, opacity 0.12s;
}

/* 盖章：从上面盖下来，落下时压一下（「已下单」「已开饭」）。章本身斜 12 度、0.85 的透明度 */
@keyframes stamp-in {
  0% {
    opacity: 0;
    transform: rotate(-12deg) scale(2.4);
    animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
  }
  70% {
    opacity: 0.85;
    transform: rotate(-12deg) scale(0.92);
    animation-timing-function: ease-out;
  }
  100% {
    opacity: 0.85;
    transform: rotate(-12deg) scale(1);
  }
}

/* 换月、换年：新的从右边（往后翻）、左边（往前翻）滑进来。1、2 轮流换着加，连着翻也每次都有动画（记录页日历、做饭总结） */
.slide-next1 {
  animation: slide-next-1 0.24s ease-out;
}

.slide-next2 {
  animation: slide-next-2 0.24s ease-out;
}

.slide-prev1 {
  animation: slide-prev-1 0.24s ease-out;
}

.slide-prev2 {
  animation: slide-prev-2 0.24s ease-out;
}

/* 展开、换个看法：淡出来 */
.unfold {
  animation: unfold 0.22s ease-out;
}

@keyframes slide-next-1 {
  from {
    opacity: 0;
    transform: translateX(60rpx);
  }
}

@keyframes slide-next-2 {
  from {
    opacity: 0;
    transform: translateX(60rpx);
  }
}

@keyframes slide-prev-1 {
  from {
    opacity: 0;
    transform: translateX(-60rpx);
  }
}

@keyframes slide-prev-2 {
  from {
    opacity: 0;
    transform: translateX(-60rpx);
  }
}

@keyframes unfold {
  from {
    opacity: 0;
    transform: translateY(-16rpx);
  }
}

/* 第一次读取时整页的占位（记录页、点菜单记录页、做饭总结）：0.25 秒内读好了就不出来，免得一闪 */
.sk-page {
  animation: sk-appear 0.2s 0.25s both;
}

@keyframes sk-appear {
  from {
    opacity: 0;
  }
}

.sk-card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
}

.sk-bar {
  height: 28rpx;
  margin-top: 18rpx;
}

.sk-bar.w30 {
  width: 30%;
  margin: 0 auto;
}

.sk-bar.w60 {
  width: 60%;
}

.sk-photo {
  height: 220rpx;
  margin: -28rpx -28rpx 0;
  border-radius: 20rpx 20rpx 0 0;
}

/* 加载中的占位块 */
.sk {
  background: #f3e8d8;
  border-radius: 12rpx;
  animation: sk-pulse 1.2s ease-in-out infinite;
}

@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

/* ---------- 按钮：只有三档 ----------
   大按钮（80rpx）：.btn-primary 黄底，一页最主要的那一下；.btn-outline 描边，旁边次要的
   中按钮（64rpx）：.btn-mid 描边，.btn-mid.main 黄底，.disabled 灰掉。一排并列的几个用它
   小胶囊（52rpx）：.pill 白底描边，.pill.pri 黄底，.pill.warn 红字。卡片、横幅里的小操作
   页面上只写位置（外边距、flex），长相都用这几个 */
.btn-primary {
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: 40rpx;
  background: var(--yolk);
  color: var(--pan);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  text-align: center;
}

.btn-outline {
  height: 80rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--pan);
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  text-align: center;
}

.btn-mid {
  height: 64rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--pan);
  border-radius: 32rpx;
  font-size: var(--fs-sub);
  line-height: 60rpx;
  text-align: center;
}

.btn-mid.main {
  border-color: var(--yolk);
  background: var(--yolk);
  font-weight: 600;
}

.btn-mid.disabled {
  border-color: var(--line);
  background: #fff;
  color: var(--text-3);
  font-weight: normal;
}

.pill {
  height: 52rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(59, 59, 66, 0.16);
  border-radius: 26rpx;
  background: #fff;
  font-size: var(--fs-small);
  line-height: 48rpx;
  color: var(--text-2);
  white-space: nowrap;
}

.pill.pri {
  border-color: var(--yolk);
  background: var(--yolk);
  color: var(--pan);
  font-weight: 600;
}

.pill.warn {
  border-color: rgba(229, 83, 75, 0.5);
  color: var(--danger);
}

.tag {
  display: inline-block;
  margin: 0 12rpx 8rpx 0;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  background: var(--cream);
  font-size: 22rpx;
  color: var(--text-2);
}

/* 熟练度标记：拿手菜 / 练习中 / 想学 */
.badge {
  flex-shrink: 0;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 34rpx;
}

.badge.mastered {
  background: var(--yolk);
  color: var(--pan);
}

.badge.learning {
  background: var(--apricot);
  color: var(--wood);
}

.badge.wish {
  background: #efeff1;
  color: var(--text-2);
}

/* 空状态 */
.empty {
  padding: 160rpx 48rpx;
  text-align: center;
}

/* 空页面的插画（images/empty/，杏色圆底 + 线条，源文件在 design/empty） */
.empty-img {
  display: block;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
}

.empty-title {
  margin-top: 16rpx;
  font-size: var(--fs-lg);
  font-weight: 600;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: var(--fs-sub);
  color: var(--text-3);
}

.empty .btn-primary {
  display: inline-block;
  margin-top: 40rpx;
}

/* ---------- 选项按钮：点一下就选上（分类、熟练度、标签、计时、日期、掌勺……） ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 0;
}

.chip {
  margin: 6rpx 16rpx 6rpx 0;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: var(--cream);
  font-size: 24rpx;
  color: var(--text-2);
}

.chip.on {
  background: var(--yolk);
  color: var(--pan);
  font-weight: 600;
}

.chip.add {
  padding: 6rpx 22rpx;
  border: 2rpx dashed #d9cfc1;
  background: #fff;
}

/* ---------- 从底部弹出的面板（选计时、选菜……） ---------- */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(59, 59, 66, 0.45);
  animation: mask-in 0.2s ease-out;
}

.sheet {
  width: 100%;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  animation: sheet-up 0.26s cubic-bezier(0.2, 0.9, 0.3, 1);
}

/* 收起：先播完这段（utils/sheet.js 的 closeSheet），再真的关掉 */
.sheet-mask.closing {
  animation: mask-out 0.18s ease-in forwards;
}

.sheet-mask.closing .sheet {
  animation: sheet-down 0.18s ease-in forwards;
  pointer-events: none; /* 正在收：面板上的按钮不再响应，点到的都算点在灰底上 */
}

@keyframes mask-in {
  from {
    background-color: rgba(59, 59, 66, 0);
  }
}

@keyframes mask-out {
  to {
    background-color: rgba(59, 59, 66, 0);
  }
}

@keyframes sheet-up {
  from {
    transform: translateY(100%);
  }
}

@keyframes sheet-down {
  to {
    transform: translateY(100%);
  }
}

.sheet-title {
  margin-bottom: 16rpx;
  font-size: var(--fs-title);
  font-weight: 700;
}

.sheet .chip {
  padding: 14rpx 28rpx;
  font-size: var(--fs-sub);
}

.sheet-foot {
  display: flex;
  margin-top: 24rpx;
}

.sheet-btn {
  flex: 1;
}

.sheet-btn + .sheet-btn {
  margin-left: 20rpx;
}

/* ---------- 头像：小本本、成员都用一个字（家庭本本是黄底） ---------- */
.av {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--apricot);
  color: var(--wood);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.av.fam {
  background: var(--yolk);
  color: var(--pan);
}

.av.sm {
  width: 44rpx;
  height: 44rpx;
  font-size: 22rpx;
  line-height: 44rpx;
}

.av.lg {
  width: 104rpx;
  height: 104rpx;
  font-size: 44rpx;
  line-height: 104rpx;
}

/* 画图片（点菜单、邀请卡片）用的画布：放在屏幕外面，看不到 */
.ticket-canvas {
  position: fixed;
  top: 0;
  left: -2000rpx;
  width: 360px;
  height: 360px;
}

/* ---------- 一顿饭（templates/meal-card.wxml，开饭时一起记的） ---------- */

.meal-card {
  margin: 0 24rpx 16rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
}

.meal-photo {
  display: block;
  width: 100%;
  height: 300rpx;
}

.meal-body {
  position: relative;
  padding: 20rpx 24rpx 24rpx;
}

.meal-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.meal-title {
  margin-right: 12rpx;
  font-size: var(--fs-title);
  font-weight: 700;
}

.meal-no {
  margin-right: 12rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: var(--fs-small);
  color: var(--wood);
}

.meal-people {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.meal-dish {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.meal-dish-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.meal-dish-name {
  min-width: 0;
  font-size: var(--fs-body);
}

/* 这道菜自己的心得（在那道菜的记录里写的） */
.meal-dish-note {
  margin-top: 4rpx;
  font-size: var(--fs-small);
  line-height: 1.5;
  color: var(--text-3);
}

.meal-qty {
  color: var(--text-3);
}

.meal-stars {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--yolk);
}

.meal-note {
  margin-top: 14rpx;
  font-size: var(--fs-sub);
  line-height: 1.6;
  color: var(--text-2);
}

.meal-acts {
  display: flex;
  margin-top: 18rpx;
}

.meal-act {
  margin-right: 16rpx;
}

/* ---------- 菜品卡片（templates/dish-card.wxml） ---------- */

.dish-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 20rpx;
}

/* 已经点进菜篮的菜：淡黄底，一眼看出点了哪些 */
.dish-card.picked {
  background: #fff6e2;
  box-shadow: inset 0 0 0 2rpx #ffe2a8;
}

.cover {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--apricot);
  color: var(--wood);
  font-size: 56rpx;
  font-weight: 700;
}

.dish-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-foot {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 12rpx;
}

.dish-cook {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 加减份数 ---------- */

.stepper {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.stepper-btn {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 46rpx;
}

/* 按钮看着小，点击范围往外扩一圈，手指好按 */
.stepper-btn::after {
  content: "";
  position: absolute;
  top: -16rpx;
  right: -14rpx;
  bottom: -16rpx;
  left: -14rpx;
}

.stepper-btn.plus {
  background: var(--yolk);
  color: var(--pan);
}

.stepper-btn.minus {
  border: 2rpx solid #d9cfc1;
  color: var(--text-2);
  line-height: 42rpx;
}

.stepper-num {
  min-width: 52rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.stepper.big .stepper-btn {
  width: 64rpx;
  height: 64rpx;
  font-size: 40rpx;
  line-height: 62rpx;
}

.stepper.big .stepper-btn.minus {
  line-height: 58rpx;
}

.stepper.big .stepper-num {
  min-width: 120rpx;
}
