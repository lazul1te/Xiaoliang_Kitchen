<view wx:if="{{gone}}" class="empty">
  <image class="empty-img" src="/images/empty/book.png" />
  <view class="empty-title">这本小本本找不到了</view>
  <view class="empty-desc">可能你已经不在这本里了</view>
</view>

<view wx:elif="{{book}}" class="page">
  <view class="head">
    <view class="av lg {{book.family ? 'fam' : ''}}">{{book.initial}}</view>
    <view class="head-name">{{book.name}}</view>
    <view class="head-sub">{{book.family ? '家庭本本 · ' + members.length + ' 人，大家都能看、都能改' : '个人本本 · 只有你能看'}}</view>
    <view wx:if="{{!isCurrent}}" class="pill pri head-switch" bindtap="onSwitchHere" hover-class="tap" hover-stay-time="100">切到这本</view>
  </view>

  <view wx:if="{{created}}" class="card tip">
    <view class="tip-title">建好啦！</view>
    <view class="para">把下面的家庭码告诉家人，或者点「邀请家人」发卡片给 TA。TA 申请以后，在这一页点「同意」，就能一起记了。</view>
  </view>

  <view class="card list">
    <view class="li" bindtap="onRename" hover-class="tap-row" hover-stay-time="100">
      <text class="li-k">名字</text>
      <text class="li-v">{{book.name}}</text>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{book.family}}" class="li" bindtap="onMyName" hover-class="tap-row" hover-stay-time="100">
      <text class="li-k">我在这本里叫</text>
      <text class="li-v {{book.myName ? '' : 'none-v'}}">{{book.myName || '还没写'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <block wx:if="{{book.family}}">
    <!-- 家庭码：大家都看得到，本主能换 -->
    <view class="card">
      <view class="row-head">
        <text class="card-title">家庭码</text>
        <text wx:if="{{book.owner}}" class="link hit" bindtap="onNewCode">换一个</text>
        <text wx:else class="hint">只有本主能换</text>
      </view>
      <view class="code">
        <text wx:for="{{codeChars}}" wx:key="i" class="code-ch">{{item.ch}}</text>
      </view>
      <view class="code-acts">
        <view class="btn-outline code-btn" bindtap="onCopyCode" hover-class="tap" hover-stay-time="100">复制</view>
        <button class="code-btn share-btn" open-type="share">邀请家人</button>
      </view>
      <view class="hint">家人输入家庭码、或者点开邀请卡片申请加入，{{book.owner ? '你' : '本主'}}同意了才算加入。体验版只有体验成员能打开。</view>
    </view>

    <!-- 加入申请：只有本主看得到 -->
    <view wx:if="{{book.owner && requests.length}}" class="card">
      <view class="card-title">等你同意 · {{requests.length}}</view>
      <view wx:for="{{requests}}" wx:key="id" class="person">
        <view class="av">{{item.initial}}</view>
        <view class="person-text">
          <view class="person-name">{{item.label}}</view>
          <view class="hint">{{item.timeText}} 申请加入</view>
        </view>
        <view class="pill req-no" data-id="{{item.id}}" data-name="{{item.label}}" bindtap="onReject" hover-class="tap" hover-stay-time="100">不同意</view>
        <view class="pill pri req-yes" data-id="{{item.id}}" bindtap="onApprove" hover-class="tap" hover-stay-time="100">同意</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">成员 · {{members.length}} 人</view>
      <view wx:for="{{members}}" wx:key="id" class="person">
        <view class="av {{item.me ? 'fam' : ''}}">{{item.initial}}</view>
        <view class="person-text">
          <text class="person-name">{{item.label}}</text>
          <text wx:if="{{item.owner}}" class="tag-owner">本主</text>
          <text wx:if="{{item.me}}" class="tag-me">我</text>
        </view>
        <view wx:if="{{book.owner && !item.me}}" class="remove" data-id="{{item.id}}" data-name="{{item.label}}" bindtap="onRemoveMember" hover-class="tap" hover-stay-time="100">移出</view>
      </view>
    </view>

    <view class="leave" bindtap="onLeave" hover-class="tap" hover-stay-time="100">退出这本</view>
  </block>

  <view wx:else class="card">
    <view class="para">这是只有你能看的个人本本，不能邀请别人。想和家人一起记，新建一本家庭本本，可以把这里的菜复制过去。</view>
    <view class="btn-outline new-btn" bindtap="onNewBook" hover-class="tap" hover-stay-time="100">新建家庭本本</view>
  </view>
</view>

<!-- 画邀请卡片封面用的画布（看不到） -->
<canvas type="2d" id="ticket-canvas" class="ticket-canvas" />
