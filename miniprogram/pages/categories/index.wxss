.cats {
  padding-bottom: 60rpx;
}

.list {
  padding-top: 0;
  padding-bottom: 0;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.row + .row {
  border-top: 2rpx solid var(--line);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
}

.row-count {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.row-tools {
  display: flex;
  align-items: center;
}

.tool {
  margin-left: 32rpx;
}

.tool.disabled {
  opacity: 0.25;
}

.tool-icon {
  display: block;
  width: 36rpx;
  height: 36rpx;
}

.hint {
  margin: 24rpx 40rpx 0;
}

.add {
  margin: 40rpx 48rpx 0;
}
