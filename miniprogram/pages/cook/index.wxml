<view wx:if="{{notFound}}" class="empty">
  <view class="empty-emoji">🍽️</view>
  <view class="empty-title">{{emptyText}}</view>
  <view class="empty-desc">可能已经被删掉了</view>
</view>

<view wx:elif="{{tab}}" class="cook">
  <!-- 一起做：上面按菜切换，第一个是备菜 -->
  <scroll-view wx:if="{{multi}}" class="ctabs" scroll-x enable-flex scroll-with-animation scroll-into-view="ct-{{tab}}">
    <view wx:for="{{tabs}}" wx:key="key" id="ct-{{item.key}}" class="ct {{item.key === tab ? 'on' : ''}} {{item.done ? 'done' : ''}}"
          data-key="{{item.key}}" bindtap="onTab">{{item.label}}<text wx:if="{{item.sub}}" class="ct-sub">{{item.sub}}</text></view>
  </scroll-view>

  <!-- 上面：第几步、进度、原料 -->
  <view class="top">
    <view class="top-row">
      <text class="step-label">{{tab === 'prep' ? '先备菜' : stepLabel}}</text>
      <view class="top-btns">
        <view wx:if="{{tab !== 'prep'}}" class="ing-btn" bindtap="onToggleIngredients"><image class="ic sm" src="/images/icons/list-wood.png" />看原料</view>
        <view wx:if="{{multi}}" class="serve-btn" bindtap="onServe">开饭</view>
      </view>
    </view>
    <view wx:if="{{tab !== 'prep'}}" class="bar"><view class="bar-fill" style="width: {{progress}}%"></view></view>
  </view>

  <view class="stage">
    <!-- 正在走的计时（一起做时写着是哪道菜），点一下跳到那一步 -->
    <view wx:if="{{running.length}}" class="running">
      <view wx:for="{{running}}" wx:key="key" class="running-chip" data-key="{{item.key}}" bindtap="onJumpStep">
        <image class="ic sm" src="/images/icons/timer-white.png" />{{item.label}}
      </view>
    </view>

    <!-- 备菜：要提前做的、建议顺序、备菜清单 -->
    <scroll-view wx:if="{{tab === 'prep'}}" scroll-y class="prep-page">
      <view wx:if="{{waits.length}}" class="prep-card warn">
        <view class="prep-title">先做这些，要等</view>
        <view wx:for="{{waits}}" wx:key="text" class="wait-row" data-id="{{item.dishId}}" data-i="{{item.index}}" bindtap="onJumpWait">
          <view class="wait-main">
            <view class="wait-dish">{{item.dishName}} · 第 {{item.index + 1}} 步</view>
            <view class="wait-text">{{item.text}}</view>
          </view>
          <text class="wait-time">{{item.timerText}} ›</text>
        </view>
      </view>

      <view class="prep-card">
        <view class="prep-title">建议顺序<text class="prep-sub">用时长的先做</text></view>
        <view wx:for="{{sequence}}" wx:key="_id" class="seq-row">
          <text class="seq-no">{{index + 1}}</text>
          <text class="seq-name">{{item.name}}</text>
          <text class="seq-time">{{item.durationText}}</text>
        </view>
        <view wx:if="{{sequenceTip}}" class="prep-tip">{{sequenceTip}}</view>
      </view>

      <view class="prep-card">
        <view class="prep-title">备菜清单<text class="prep-sub">用量按份数算好了，切好一样勾一样</text></view>
        <view wx:for="{{prep}}" wx:key="dishId" wx:for-item="g" class="prep-group">
          <view class="prep-group-title">{{g.title}}</view>
          <view wx:for="{{g.items}}" wx:key="key" class="prep-row {{item.checked ? 'done' : ''}}" data-key="{{item.key}}" bindtap="onTogglePrep">
            <view class="check">{{item.checked ? '✓' : ''}}</view>
            <text class="prep-name">{{item.name}}</text>
            <text class="prep-amount">{{item.amountText}}</text>
          </view>
          <view wx:if="{{g.seasonings}}" class="prep-season">调料：{{g.seasonings}}</view>
        </view>
      </view>
    </scroll-view>

    <!-- 做菜：每一步一页，左右滑动。换了菜就重新建，直接停在那道菜做到的那一步 -->
    <block wx:else>
      <swiper wx:for="{{[swiperKey]}}" wx:for-item="sk" wx:for-index="ski" wx:key="*this" class="swiper" current="{{current}}" duration="250" bindchange="onSwipe">
        <swiper-item wx:for="{{steps}}" wx:key="key">
          <scroll-view scroll-y class="page">
            <view class="step-no">第 {{index + 1}} 步</view>
            <view class="step-text">{{item.text}}</view>
            <cloud-image wx:if="{{item.image}}" class="step-img" src="{{item.image}}" mode="widthFix" />
            <view wx:if="{{item.hasTimer}}" class="timer {{item.timerState}}">
              <view class="timer-time">{{item.timerText}}</view>
              <view class="timer-actions">
                <view class="timer-btn main" data-i="{{index}}" bindtap="onTimerMain">{{item.timerAction}}</view>
                <view wx:if="{{item.timerState !== 'idle'}}" class="timer-btn" data-i="{{index}}" bindtap="onTimerReset">重置</view>
              </view>
            </view>
          </scroll-view>
        </swiper-item>

        <!-- 最后一页 -->
        <swiper-item>
          <view class="page finish">
            <block wx:if="{{multi}}">
              <view class="finish-emoji">{{dishDone ? '✅' : '🍳'}}</view>
              <view class="finish-title">{{dish.name}}{{dishDone ? '做好了' : '做好了吗？'}}</view>
              <view class="finish-desc">{{nextText}}</view>
              <view wx:if="{{!dishDone}}" class="btn-primary finish-btn" bindtap="onDishDone">这道做好了</view>
              <view wx:else class="btn-outline finish-btn" bindtap="onDishUndo">还没好，接着做</view>
              <view class="finish-skip" bindtap="onServe">直接开饭</view>
            </block>
            <block wx:else>
              <view class="finish-emoji">{{total ? '🎉' : '📝'}}</view>
              <view class="finish-title">{{total ? '做好啦！' : '这道菜还没写做法'}}</view>
              <view class="finish-desc">{{total ? '拍张照、记两句，下次做得更好' : '可以先去把步骤写上，也可以直接打卡'}}</view>
              <view class="btn-primary finish-btn" bindtap="onFinish">打个卡</view>
              <view wx:if="{{!total}}" class="btn-outline finish-btn" bindtap="onEditDish">去写做法</view>
              <view class="finish-skip" bindtap="onBack">不记了，返回</view>
            </block>
          </view>
        </swiper-item>
      </swiper>
    </block>
  </view>

  <!-- 下面：上一步 / 下一步；备菜页是「开始做」 -->
  <view class="bottom">
    <view wx:if="{{tab === 'prep'}}" class="nav-btn main" bindtap="onStartCooking">{{startText}}</view>
    <block wx:else>
      <view class="nav-btn {{current === 0 ? 'disabled' : ''}}" bindtap="onPrev">上一步</view>
      <view wx:if="{{current !== total}}" class="nav-btn main" bindtap="onNext">{{current === total - 1 ? '做完了' : '下一步'}}</view>
      <view wx:elif="{{!multi}}" class="nav-btn main" bindtap="onFinish">打个卡</view>
      <view wx:elif="{{!dishDone}}" class="nav-btn main" bindtap="onDishDone">这道做好了</view>
      <view wx:else class="nav-btn main" bindtap="onServe">开饭</view>
    </block>
  </view>

  <!-- 原料清单（从下面弹出来，用量按份数算好了） -->
  <view wx:if="{{showIngredients}}" class="sheet-mask" bindtap="onToggleIngredients">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{dish.name}} · 原料{{dish.qty > 1 ? '（' + dish.qty + ' 份）' : ''}}</view>
      <view wx:if="{{!dish.ingredientGroups.length}}" class="sheet-none">还没写原料</view>
      <view wx:for="{{dish.ingredientGroups}}" wx:key="type" wx:for-item="group" class="sheet-group">
        <view class="sheet-label">{{group.label}}</view>
        <view wx:for="{{group.items}}" wx:key="key" class="sheet-row">
          <text>{{item.name}}</text>
          <text class="sheet-amount">{{item.amountText}}</text>
        </view>
      </view>
      <view class="btn-outline sheet-close" bindtap="onToggleIngredients">收起</view>
    </view>
  </view>
</view>
