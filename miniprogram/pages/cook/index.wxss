/* 上面（一起做的标签、第几步）+ 中间（滑动区 / 备菜）+ 下面按钮，正好铺满一屏 */
.cook {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}

/* ---------- 一起做：按菜切换的标签 ---------- */

.ctabs {
  flex-shrink: 0;
  display: flex;
  height: 88rpx;
  padding: 0 16rpx;
  background: #fff;
  white-space: nowrap;
  box-shadow: 0 2rpx 0 var(--line);
}

.ct {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  margin: 14rpx 8rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: var(--cream);
  font-size: var(--fs-small);
  color: var(--text-2);
}

.ct-sub {
  margin-left: 8rpx;
  font-size: var(--fs-tiny);
}

.ct.on {
  background: var(--yolk);
  color: var(--pan);
  font-weight: 600;
}

/* 做好了的：绿色 */
.ct.done {
  background: #e3f2e1;
  color: #3e8a3b;
}

.ct.done.on {
  background: var(--scallion);
  color: #fff;
}

/* ---------- 上面 ---------- */

.top {
  flex-shrink: 0;
  height: 120rpx;
  padding: 20rpx 32rpx 0;
  background: var(--cream);
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step-label {
  font-size: 30rpx;
  font-weight: 700;
}

.top-btns {
  display: flex;
  align-items: center;
}

.serve-btn {
  margin-left: 16rpx;
  border-color: var(--pan);
  background: var(--pan);
  color: #fff;
}

.ing-btn {
  display: flex;
  align-items: center;
  color: var(--wood);
}

.bar {
  height: 10rpx;
  margin-top: 20rpx;
  border-radius: 5rpx;
  background: var(--line);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 5rpx;
  background: var(--yolk);
  transition: width 0.25s;
}

/* 中间：滑动区或者备菜，占满剩下的高度 */
.stage {
  position: relative;
  flex: 1;
  min-height: 0;
}

/* 正在走的计时，浮在滑动区上面 */
.running {
  position: absolute;
  top: 12rpx;
  right: 24rpx;
  left: 24rpx;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
}

.running-chip {
  display: flex;
  align-items: center;
  font-variant-numeric: tabular-nums; /* 数字等宽：走的时候不晃 */
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background: var(--pan);
  font-size: 24rpx;
  color: #fff;
}

/* ---------- 中间：每一步 ---------- */

.swiper {
  height: 100%;
}

.page {
  box-sizing: border-box;
  height: 100%;
  padding: 72rpx 48rpx 40rpx;
}

.step-no {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--wood);
}

/* 字大一点，站在灶台边也看得清 */
.step-text {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.7;
}

.step-img {
  display: block;
  width: 100%;
  margin-top: 28rpx;
  border-radius: 16rpx;
}

.timer {
  margin-top: 40rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--cream);
  text-align: center;
}

/* 数字等宽：倒计时走的时候不左右晃 */
.timer-time {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 4rpx;
  font-variant-numeric: tabular-nums;
}

.timer.running .timer-time {
  color: var(--wood);
}

.timer.done .timer-time {
  color: var(--scallion);
}

.timer-actions {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.timer-btn {
  margin: 0 12rpx;
  padding: 0 40rpx;
  border: 2rpx solid var(--pan);
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 72rpx;
}

.timer-btn.main {
  border-color: var(--yolk);
  background: var(--yolk);
  font-weight: 600;
}

/* 最后一页 */
.finish {
  text-align: center;
}

.finish-emoji {
  margin-top: 80rpx;
  font-size: 120rpx;
}

.finish-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.finish-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.finish-btn {
  width: 440rpx;
  margin: 48rpx auto 0;
}

.finish-btn + .finish-btn {
  margin-top: 24rpx;
}

.finish-skip {
  margin-top: 36rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

/* ---------- 备菜 ---------- */

.prep-page {
  height: 100%;
  background: var(--cream);
}

.prep-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
}

.prep-card:last-child {
  margin-bottom: 32rpx;
}

/* 有计时在走：第一张卡片往下让一让，不被计时盖住 */
.running + .prep-page .prep-card:first-child {
  margin-top: 96rpx;
}

.prep-card.warn {
  background: #fff6e2;
  box-shadow: inset 0 0 0 2rpx #ffe2a8;
}

.prep-title {
  margin-bottom: 8rpx;
  font-size: var(--fs-title);
  font-weight: 700;
}

.prep-sub {
  margin-left: 12rpx;
  font-size: var(--fs-tiny);
  font-weight: 400;
  color: var(--text-3);
}

.wait-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.wait-main {
  flex: 1;
  min-width: 0;
}

.wait-dish {
  font-size: var(--fs-body);
  font-weight: 600;
}

.wait-text {
  font-size: var(--fs-small);
  color: var(--text-2);
}

.wait-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-small);
  color: var(--wood);
  font-variant-numeric: tabular-nums;
}

.seq-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.seq-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--cream);
  text-align: center;
  font-size: var(--fs-tiny);
  font-weight: 700;
  line-height: 40rpx;
  color: var(--wood);
}

.seq-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
}

.seq-time {
  flex-shrink: 0;
  font-size: var(--fs-small);
  color: var(--text-3);
}

.prep-tip {
  margin-top: 8rpx;
  font-size: var(--fs-small);
  color: var(--text-3);
}

.prep-group + .prep-group {
  margin-top: 16rpx;
}

.prep-group-title {
  padding: 8rpx 0;
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--wood);
}

.prep-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border: 3rpx solid #d9cfc1;
  border-radius: 50%;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #fff;
}

.prep-row.done .check {
  border-color: var(--scallion);
  background: var(--scallion);
}

.prep-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
}

.prep-amount {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-sub);
  color: var(--text-2);
}

/* 备好了：变淡、划掉 */
.prep-row.done .prep-name,
.prep-row.done .prep-amount {
  color: var(--text-3);
  text-decoration: line-through;
}

.prep-season {
  margin-top: 10rpx;
  font-size: var(--fs-small);
  color: var(--text-3);
}

/* ---------- 下面 ---------- */

.bottom {
  flex-shrink: 0;
  display: flex;
  height: calc(136rpx + env(safe-area-inset-bottom));
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(59, 59, 66, 0.06);
}

.nav-btn {
  flex: 1;
  height: 96rpx;
  border: 2rpx solid var(--pan);
  border-radius: 48rpx;
  text-align: center;
  font-size: 32rpx;
  line-height: 92rpx;
}

.nav-btn + .nav-btn {
  margin-left: 24rpx;
}

.nav-btn.main {
  border-color: var(--yolk);
  background: var(--yolk);
  font-weight: 600;
}

.nav-btn.disabled {
  border-color: var(--line);
  color: var(--text-3);
}

/* ---------- 原料清单 ---------- */

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.35);
}

.sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 80vh;
  padding: 36rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
  overflow-y: auto;
}

.sheet-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-none {
  font-size: 26rpx;
  color: var(--text-3);
}

.sheet-group + .sheet-group {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.sheet-label {
  font-size: 24rpx;
  color: var(--wood);
}

.sheet-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 32rpx;
}

.sheet-amount {
  color: var(--text-2);
}

.sheet-close {
  margin-top: 28rpx;
}
