<view wx:if="{{notFound}}" class="empty">
  <image class="empty-img" src="/images/empty/plate.png" />
  <view class="empty-title">这道菜找不到了</view>
  <view class="empty-desc">可能已经被删掉了</view>
</view>

<view wx:elif="{{dish}}" class="detail">
  <!-- 成品图；没有照片时用菜名第一个字占位 -->
  <cloud-image wx:if="{{dish.cover && !heroBroken}}" class="hero" src="{{dish.cover}}" mode="aspectFill" binderror="onHeroError" />
  <view wx:else class="hero hero-placeholder">
    <text class="hero-initial">{{dish.initial}}</text>
    <text class="hero-tip">还没有成品照</text>
  </view>

  <!-- 名称、标签、耗时/份量/难度 -->
  <view class="card head">
    <view class="title-row">
      <text class="title">{{dish.name}}</text>
      <view class="badge {{dish.statusClass}}">{{dish.statusText}}</view>
    </view>
    <view wx:if="{{dish.tags.length}}" class="tags">
      <text wx:for="{{dish.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
    <view class="facts">
      <view class="fact">
        <text class="fact-value">{{dish.duration || '—'}}</text>
        <text wx:if="{{dish.duration}}" class="fact-unit">分钟</text>
        <view class="fact-label">耗时</view>
      </view>
      <view class="fact">
        <text class="fact-value">{{dish.servings || '—'}}</text>
        <text wx:if="{{dish.servings}}" class="fact-unit">人份</text>
        <view class="fact-label">份量</view>
      </view>
      <view class="fact">
        <text class="stars">{{dish.stars}}</text>
        <view class="fact-label">难度</view>
      </view>
    </view>
    <view class="cook-line">{{dish.cookLine}}<text wx:if="{{dish.updatedText}}"> · {{dish.updatedText}}改过</text></view>
  </view>

  <!-- 原料 -->
  <view class="card">
    <view class="card-title">原料</view>
    <view wx:if="{{!dish.ingredientGroups.length}}" class="none">还没写原料，点左下角「编辑」补上</view>
    <view wx:for="{{dish.ingredientGroups}}" wx:key="type" wx:for-item="group" class="ing-group">
      <view class="ing-label">{{group.label}}</view>
      <view class="ing-items">
        <view wx:for="{{group.items}}" wx:key="key" class="ing-row">
          <text>{{item.name}}</text>
          <text class="ing-amount">{{item.amountText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 做法 -->
  <view class="card">
    <view class="card-title">做法{{dish.steps.length ? ' · ' + dish.steps.length + ' 步' : ''}}</view>
    <view wx:if="{{!dish.steps.length}}" class="none">还没写做法</view>
    <view wx:for="{{dish.steps}}" wx:key="key" class="step">
      <view class="step-no">{{index + 1}}</view>
      <view class="step-body">
        <view wx:if="{{item.text}}" class="step-text">{{item.text}}</view>
        <cloud-image wx:if="{{item.image}}" class="step-img" src="{{item.image}}" mode="widthFix" />
        <view wx:if="{{item.timerText}}" class="step-timer"><image class="ic sm" src="/images/icons/timer-wood.png" />计时 {{item.timerText}}</view>
      </view>
    </view>
  </view>

  <!-- 小贴士 -->
  <view wx:if="{{dish.tips}}" class="card tips">
    <view class="card-title">小贴士</view>
    <view class="tips-text">{{dish.tips}}</view>
  </view>

  <!-- 做菜记录 -->
  <view class="card">
    <view class="logs-head">
      <text class="card-title">做菜记录{{logCount ? ' · ' + logCount + ' 次' : ''}}</text>
      <text class="logs-add" bindtap="onAddLog">＋ 记一次</text>
    </view>
    <view wx:if="{{!logs.length}}" class="none">还没打过卡。点下面的「开始做」，做完打个卡</view>
    <view wx:for="{{logs}}" wx:key="_id" class="mini-log" data-id="{{item._id}}" bindtap="onOpenLog" hover-class="tap-card" hover-stay-time="100">
      <cloud-image wx:if="{{item.photo}}" class="mini-photo" src="{{item.photo}}" mode="aspectFill" />
      <view class="mini-info">
        <view class="mini-head">
          <text>{{item.dayText}}</text>
          <text wx:if="{{item.stars}}" class="mini-stars">{{item.stars}}</text>
        </view>
        <view wx:if="{{item.note}}" class="mini-note">{{item.note}}</view>
        <view wx:if="{{item.cook}}" class="mini-cook">掌勺：{{item.cook}}</view>
      </view>
    </view>
    <view wx:if="{{logCount > logs.length}}" class="logs-more" bindtap="onAllLogs" hover-class="tap" hover-stay-time="100">在「记录」里看全部 ›</view>
  </view>

  <view wx:if="{{canCopy}}" class="copy-link" bindtap="onCopyToBook" hover-class="tap" hover-stay-time="100">复制到另一本小本本 ›</view>
</view>

<!-- 底部操作栏 -->
<view wx:if="{{dish}}" class="action-bar">
  <view class="action-edit" bindtap="onEdit" hover-class="tap" hover-stay-time="100">
    <image class="action-icon" src="/images/icons/edit.png" />
    <text>编辑</text>
  </view>
  <view class="action-basket">
    <view wx:if="{{qty === 0}}" class="btn-outline" bindtap="onPlus" hover-class="tap" hover-stay-time="100">加入菜篮</view>
    <view wx:else class="stepper big">
      <view class="stepper-btn minus" bindtap="onMinus" hover-class="tap" hover-stay-time="100">−</view>
      <text class="stepper-num">{{qty}} 份</text>
      <view class="stepper-btn plus" bindtap="onPlus" hover-class="tap" hover-stay-time="100">+</view>
    </view>
  </view>
  <view class="btn-primary" bindtap="onStartCook" hover-class="tap" hover-stay-time="100">开始做</view>
</view>
