/* 底部留出操作栏的高度 */
.detail {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ---------- 成品图 ---------- */

.hero {
  display: block;
  width: 100%;
  height: 420rpx;
}

.hero-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--apricot);
}

.hero-initial {
  font-size: 160rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--wood);
}

.hero-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--wood);
  opacity: 0.7;
}

/* ---------- 名称和基本信息 ---------- */

/* 往上压一点，盖住成品图底边 */
.head {
  position: relative;
  margin-top: -48rpx;
}

.title-row {
  display: flex;
  align-items: center;
}

.title {
  margin-right: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.tags {
  margin-top: 14rpx;
}

.facts {
  display: flex;
  margin-top: 16rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
}

.fact {
  flex: 1;
  text-align: center;
}

.fact-value {
  font-size: 36rpx;
  font-weight: 700;
}

.fact-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: var(--text-2);
}

.fact-label {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.stars {
  display: inline-block;
  height: 54rpx;
  font-size: 28rpx;
  line-height: 54rpx;
  letter-spacing: 2rpx;
  color: var(--yolk);
}

.cook-line {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

/* 还没填原料、做法时的提示 */

/* ---------- 原料 ---------- */

.ing-group {
  display: flex;
  padding: 12rpx 0;
}

.ing-group + .ing-group {
  border-top: 2rpx dashed var(--line);
}

.ing-label {
  flex-shrink: 0;
  width: 88rpx;
  padding-top: 8rpx;
  font-size: 24rpx;
  color: var(--wood);
}

.ing-items {
  flex: 1;
}

.ing-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 28rpx;
}

.ing-amount {
  color: var(--text-2);
}

/* ---------- 做法 ---------- */

.step {
  display: flex;
  padding: 14rpx 0;
}

.step-no {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: var(--yolk);
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.step-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.step-text {
  font-size: 28rpx;
  line-height: 1.7;
}

.step-img {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  border-radius: 12rpx;
}

.step-timer {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 4rpx 18rpx 4rpx 14rpx;
  border-radius: 24rpx;
  background: #fff2d9;
  font-size: var(--fs-small);
  color: var(--wood);
}

/* ---------- 小贴士 ---------- */

.tips {
  background: #fff2d9;
}

.tips-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-2);
}

/* ---------- 做菜记录 ---------- */

.logs-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.logs-add {
  font-size: 26rpx;
  color: var(--wood);
}

.mini-log {
  display: flex;
  padding: 16rpx 0;
  border-top: 2rpx solid var(--line);
}

.mini-photo {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
}

.mini-info {
  flex: 1;
  min-width: 0;
}

.mini-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-2);
}

.mini-stars {
  color: var(--yolk);
}

.mini-note {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.mini-cook {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.logs-more {
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
  text-align: center;
  font-size: 24rpx;
  color: var(--wood);
}

/* 复制到另一本小本本 */
.copy-link {
  margin: 32rpx 24rpx 0;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--text-2);
}

/* ---------- 底部操作栏 ---------- */

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(59, 59, 66, 0.06);
}

/* 编辑：图标 + 小字，给「开始做」多留地方 */
.action-edit {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
  font-size: var(--fs-tiny);
  line-height: 1.3;
  color: var(--text-2);
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.action-basket {
  flex: 1;
  display: flex;
  justify-content: center;
  margin: 0 16rpx;
}

.action-basket .btn-outline {
  width: 100%;
}
