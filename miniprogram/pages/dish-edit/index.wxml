<view wx:if="{{form}}" class="edit">
  <!-- 成品照：点一下选照片 -->
  <view class="cover-box" bindtap="onChooseCover" hover-class="tap-card" hover-stay-time="100">
    <cloud-image wx:if="{{form.cover}}" class="cover-img" src="{{form.cover}}" mode="aspectFill" />
    <view wx:else class="cover-empty">
      <image class="ic xl" src="/images/icons/camera-wood.png" />
      <text>添加成品照</text>
    </view>
    <view wx:if="{{form.cover}}" class="cover-actions">
      <view class="cover-btn">换一张</view>
      <view class="cover-btn" catchtap="onRemoveCover" hover-class="tap" hover-stay-time="100" hover-stop-propagation>删除</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="field">
      <text class="label">菜名</text>
      <input class="input" value="{{form.name}}" placeholder="比如：番茄炒蛋" maxlength="20"
             data-field="name" bindinput="onInput" />
    </view>
    <view class="field field-wrap">
      <text class="label">分类</text>
      <view class="chips">
        <view wx:for="{{categories}}" wx:key="_id" class="chip {{form.categoryId === item._id ? 'on' : ''}}"
              data-id="{{item._id}}" bindtap="onCategoryTap" hover-class="tap" hover-stay-time="100">{{item.name}}</view>
        <view class="chip add" bindtap="onNewCategory" hover-class="tap" hover-stay-time="100">＋ 新建</view>
      </view>
    </view>
    <view class="field">
      <text class="label">熟练度</text>
      <view class="chips">
        <view wx:for="{{statusOptions}}" wx:key="value" class="chip {{form.status === item.value ? 'on' : ''}}"
              data-value="{{item.value}}" bindtap="onStatusTap" hover-class="tap" hover-stay-time="100">{{item.text}}</view>
      </view>
    </view>
    <view class="field">
      <text class="label">难度</text>
      <view class="stars">
        <text wx:for="{{stars}}" wx:key="*this" class="star {{form.difficulty >= item ? 'on' : ''}}"
              data-value="{{item}}" bindtap="onStarTap">★</text>
        <text class="star-text">{{difficultyLabels[form.difficulty]}}</text>
      </view>
    </view>
    <view class="field">
      <text class="label">耗时</text>
      <input class="input short" type="number" value="{{form.duration}}" placeholder="30" maxlength="4"
             data-field="duration" bindinput="onInput" />
      <text class="unit">分钟</text>
    </view>
    <view class="field">
      <text class="label">份量</text>
      <input class="input short" type="number" value="{{form.servings}}" placeholder="2" maxlength="2"
             data-field="servings" bindinput="onInput" />
      <text class="unit">人份</text>
    </view>
  </view>

  <!-- 标签 -->
  <view class="card">
    <view class="card-title">标签</view>
    <view class="chips">
      <view wx:for="{{tagChips}}" wx:key="name" class="chip {{item.on ? 'on' : ''}}"
            data-tag="{{item.name}}" bindtap="onTagTap" hover-class="tap" hover-stay-time="100">{{item.name}}</view>
      <view class="chip add" bindtap="onAddTag" hover-class="tap" hover-stay-time="100">＋ 自定义</view>
    </view>
  </view>

  <!-- 原料：主料 / 辅料 / 调料 -->
  <view class="card">
    <view class="card-title">原料</view>
    <view wx:for="{{form.groups}}" wx:key="type" wx:for-item="group" wx:for-index="g" class="group">
      <view class="group-label">{{group.label}}</view>
      <view wx:for="{{group.items}}" wx:key="key" class="ing-row">
        <input class="ing-input ing-name" value="{{item.name}}" placeholder="{{group.placeholder}}" maxlength="20"
               data-g="{{g}}" data-i="{{index}}" data-field="name" bindinput="onIngInput" />
        <input class="ing-input ing-qty" value="{{item.qty}}" placeholder="用量，如 2个" maxlength="12"
               data-g="{{g}}" data-i="{{index}}" data-field="qty" bindinput="onIngInput" />
        <view class="row-remove" data-g="{{g}}" data-i="{{index}}" bindtap="onRemoveIng" hover-class="tap" hover-stay-time="100">×</view>
      </view>
      <view class="row-add" data-g="{{g}}" bindtap="onAddIng" hover-class="tap" hover-stay-time="100">＋ 添加{{group.label}}</view>
    </view>
    <view class="hint">用量写「2个」「300克」「1/2小勺」「适量」都行；名称空着的行保存时会自动去掉</view>
  </view>

  <!-- 做法：每一步可以配一张图、设一个计时 -->
  <view class="card">
    <view class="card-title">做法</view>
    <view wx:for="{{form.steps}}" wx:key="key" class="step">
      <view class="step-head">
        <view class="step-no">{{index + 1}}</view>
        <view class="step-tools">
          <view wx:if="{{index > 0}}" class="tool hit" data-i="{{index}}" data-dir="{{-1}}" bindtap="onMoveStep" hover-class="tap" hover-stay-time="100">
            <image class="tool-icon" src="/images/icons/up-gray.png" />
          </view>
          <view wx:if="{{index !== form.steps.length - 1}}" class="tool hit" data-i="{{index}}" data-dir="{{1}}" bindtap="onMoveStep" hover-class="tap" hover-stay-time="100">
            <image class="tool-icon" src="/images/icons/down-gray.png" />
          </view>
          <view class="tool hit" data-i="{{index}}" bindtap="onRemoveStep" hover-class="tap" hover-stay-time="100">
            <image class="tool-icon" src="/images/icons/trash-red.png" />
          </view>
        </view>
      </view>
      <textarea class="text-input" value="{{item.text}}" placeholder="这一步怎么做，比如：热锅凉油，倒入蛋液炒散"
                auto-height maxlength="-1" cursor-spacing="80" data-i="{{index}}" bindinput="onStepInput" />
      <view wx:if="{{item.image}}" class="step-img-box">
        <cloud-image class="step-img" src="{{item.image}}" mode="aspectFill" />
        <view class="img-remove" data-i="{{index}}" bindtap="onRemoveStepImage" hover-class="tap" hover-stay-time="100">×</view>
      </view>
      <view class="step-extra">
        <view wx:if="{{!item.image}}" class="pill extra-btn" data-i="{{index}}" bindtap="onStepImage" hover-class="tap" hover-stay-time="100">
          <image class="ic sm" src="/images/icons/camera-gray.png" />加照片
        </view>
        <view class="pill extra-btn {{item.timer ? 'on' : ''}}" data-i="{{index}}" bindtap="onOpenTimer" hover-class="tap" hover-stay-time="100">
          <image class="ic sm" src="/images/icons/timer-wood.png" />{{item.timerText || '加计时'}}
        </view>
        <text wx:if="{{item.timer}}" class="extra-clear" data-i="{{index}}" bindtap="onClearTimer">不计时</text>
      </view>
    </view>
    <view class="row-add" bindtap="onAddStep" hover-class="tap" hover-stay-time="100">＋ 添加步骤</view>
  </view>

  <!-- 小贴士 -->
  <view class="card">
    <view class="card-title">小贴士</view>
    <textarea class="text-input" value="{{form.tips}}" placeholder="火候、替换食材、踩过的坑……"
              auto-height maxlength="-1" cursor-spacing="80" data-field="tips" bindinput="onInput" />
  </view>
</view>

<!-- 底部保存栏 -->
<view wx:if="{{form}}" class="save-bar">
  <view wx:if="{{isEdit}}" class="delete-btn" bindtap="onDelete" hover-class="tap" hover-stay-time="100">删除</view>
  <view class="btn-primary save-btn" bindtap="onSave" hover-class="tap" hover-stay-time="100">保存</view>
</view>

<!-- 计时：常用时长点一下，别的时长自己写 -->
<view wx:if="{{timerStep >= 0}}" class="sheet-mask {{timerClosing ? 'closing' : ''}}" bindtap="onCloseTimer">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">第 {{timerStep + 1}} 步计时多久</view>
    <view class="chips">
      <view wx:for="{{timerPresets}}" wx:key="value" class="chip {{timerCurrent === item.value ? 'on' : ''}}"
            data-value="{{item.value}}" bindtap="onPickTimer" hover-class="tap" hover-stay-time="100">{{item.text}}</view>
      <view class="chip add" bindtap="onCustomTimer" hover-class="tap" hover-stay-time="100">自定义…</view>
    </view>
    <view class="sheet-foot">
      <view class="btn-mid sheet-btn" bindtap="onNoTimer" hover-class="tap" hover-stay-time="100">不计时</view>
      <view class="btn-mid sheet-btn" bindtap="onCloseTimer" hover-class="tap" hover-stay-time="100">取消</view>
    </view>
  </view>
</view>
