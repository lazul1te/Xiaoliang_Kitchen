<view wx:if="{{form}}" class="edit">
  <!-- 成品照：点一下选照片 -->
  <view class="cover-box" bindtap="onChooseCover">
    <image wx:if="{{form.cover}}" class="cover-img" src="{{form.cover}}" mode="aspectFill" />
    <view wx:else class="cover-empty">
      <text class="cover-icon">📷</text>
      <text>添加成品照</text>
    </view>
    <view wx:if="{{form.cover}}" class="cover-actions">
      <text class="cover-btn">换一张</text>
      <text class="cover-btn" catchtap="onRemoveCover">删除</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="field">
      <text class="label">菜名</text>
      <input class="input" value="{{form.name}}" placeholder="比如：番茄炒蛋" maxlength="20"
             data-field="name" bindinput="onInput" />
    </view>
    <picker range="{{categoryNames}}" value="{{pickerIndex}}" bindchange="onCategoryChange">
      <view class="field">
        <text class="label">分类</text>
        <text class="value {{categoryName ? '' : 'placeholder'}}">{{categoryName || '选一个分类'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
    <view class="field">
      <text class="label">熟练度</text>
      <view class="chips">
        <view wx:for="{{statusOptions}}" wx:key="value" class="chip {{form.status === item.value ? 'on' : ''}}"
              data-value="{{item.value}}" bindtap="onStatusTap">{{item.text}}</view>
      </view>
    </view>
    <view class="field">
      <text class="label">难度</text>
      <view class="stars">
        <text wx:for="{{stars}}" wx:key="*this" class="star {{form.difficulty >= item ? 'on' : ''}}"
              data-value="{{item}}" bindtap="onStarTap">★</text>
        <text class="star-text">{{difficultyLabels[form.difficulty]}}</text>
      </view>
    </view>
    <view class="field">
      <text class="label">耗时</text>
      <input class="input short" type="number" value="{{form.duration}}" placeholder="30" maxlength="4"
             data-field="duration" bindinput="onInput" />
      <text class="unit">分钟</text>
    </view>
    <view class="field">
      <text class="label">份量</text>
      <input class="input short" type="number" value="{{form.servings}}" placeholder="2" maxlength="2"
             data-field="servings" bindinput="onInput" />
      <text class="unit">人份</text>
    </view>
  </view>

  <!-- 标签 -->
  <view class="card">
    <view class="card-title">标签</view>
    <view class="chips">
      <view wx:for="{{tagChips}}" wx:key="name" class="chip {{item.on ? 'on' : ''}}"
            data-tag="{{item.name}}" bindtap="onTagTap">{{item.name}}</view>
      <view class="chip add" bindtap="onAddTag">＋ 自定义</view>
    </view>
  </view>

  <!-- 原料：主料 / 辅料 / 调料 -->
  <view class="card">
    <view class="card-title">原料</view>
    <view wx:for="{{form.groups}}" wx:key="type" wx:for-item="group" wx:for-index="g" class="group">
      <view class="group-label">{{group.label}}</view>
      <view wx:for="{{group.items}}" wx:key="key" class="ing-row">
        <input class="ing-input ing-name" value="{{item.name}}" placeholder="{{group.placeholder}}" maxlength="20"
               data-g="{{g}}" data-i="{{index}}" data-field="name" bindinput="onIngInput" />
        <input class="ing-input ing-amount" value="{{item.amount}}" placeholder="用量" maxlength="10"
               data-g="{{g}}" data-i="{{index}}" data-field="amount" bindinput="onIngInput" />
        <input class="ing-input ing-unit" value="{{item.unit}}" placeholder="单位" maxlength="6"
               data-g="{{g}}" data-i="{{index}}" data-field="unit" bindinput="onIngInput" />
        <view class="row-remove" data-g="{{g}}" data-i="{{index}}" bindtap="onRemoveIng">×</view>
      </view>
      <view class="row-add" data-g="{{g}}" bindtap="onAddIng">＋ 添加{{group.label}}</view>
    </view>
    <view class="hint">用量可以写「适量」「1/2」，单位可以空着；名称空着的行保存时会自动去掉</view>
  </view>

  <!-- 做法：每一步可以配一张图、设一个计时 -->
  <view class="card">
    <view class="card-title">做法</view>
    <view wx:for="{{form.steps}}" wx:key="key" class="step">
      <view class="step-head">
        <view class="step-no">{{index + 1}}</view>
        <view class="step-tools">
          <text wx:if="{{index > 0}}" class="tool" data-i="{{index}}" data-dir="{{-1}}" bindtap="onMoveStep">上移</text>
          <text wx:if="{{index !== form.steps.length - 1}}" class="tool" data-i="{{index}}" data-dir="{{1}}"
                bindtap="onMoveStep">下移</text>
          <text class="tool danger" data-i="{{index}}" bindtap="onRemoveStep">删除</text>
        </view>
      </view>
      <textarea class="text-input" value="{{item.text}}" placeholder="这一步怎么做，比如：热锅凉油，倒入蛋液炒散"
                auto-height maxlength="-1" cursor-spacing="80" data-i="{{index}}" bindinput="onStepInput" />
      <view wx:if="{{item.image}}" class="step-img-box">
        <image class="step-img" src="{{item.image}}" mode="aspectFill" />
        <view class="img-remove" data-i="{{index}}" bindtap="onRemoveStepImage">×</view>
      </view>
      <view class="step-extra">
        <view wx:if="{{!item.image}}" class="extra-btn" data-i="{{index}}" bindtap="onStepImage">📷 加照片</view>
        <picker mode="multiSelector" range="{{timerRange}}" value="{{item.timerValue}}"
                data-i="{{index}}" bindchange="onStepTimerChange">
          <view class="extra-btn {{item.timer ? 'on' : ''}}">⏱ {{item.timerText || '加计时'}}</view>
        </picker>
        <text wx:if="{{item.timer}}" class="extra-clear" data-i="{{index}}" bindtap="onClearTimer">不计时</text>
      </view>
    </view>
    <view class="row-add" bindtap="onAddStep">＋ 添加步骤</view>
  </view>

  <!-- 小贴士 -->
  <view class="card">
    <view class="card-title">小贴士</view>
    <textarea class="text-input" value="{{form.tips}}" placeholder="火候、替换食材、踩过的坑……"
              auto-height maxlength="-1" cursor-spacing="80" data-field="tips" bindinput="onInput" />
  </view>
</view>

<!-- 底部保存栏 -->
<view wx:if="{{form}}" class="save-bar">
  <view wx:if="{{isEdit}}" class="delete-btn" bindtap="onDelete">删除</view>
  <view class="btn-primary save-btn" bindtap="onSave">保存</view>
</view>
