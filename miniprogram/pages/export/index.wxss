.export {
  padding-bottom: 60rpx;
}


.row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.row-value {
  color: var(--text-2);
}

.option {
  display: flex;
  align-items: center;
}

.checkbox {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border: 3rpx solid #d9cfc1;
  border-radius: 10rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.checkbox.on {
  border-color: var(--yolk);
  background: var(--yolk);
}


/* ---------- 两步 ---------- */

.step {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.step + .step {
  border-top: 2rpx solid var(--line);
}

.step-no {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--yolk);
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.step-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
}

.step-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-3);
}

.step-desc.ok {
  color: var(--scallion);
}

.step-btn {
  flex-shrink: 0;
  padding: 0 32rpx;
  border: 2rpx solid var(--pan);
  border-radius: 32rpx;
  font-size: 26rpx;
  line-height: 60rpx;
}

.step-btn.main {
  border-color: var(--yolk);
  background: var(--yolk);
  font-weight: 600;
}

/* 第 2 步：几种存法 */
.save-actions {
  display: flex;
  margin: 0 0 16rpx 64rpx;
}

.save-btn {
  flex: 1;
  padding: 0 8rpx;
  border: 2rpx solid var(--pan);
  border-radius: 32rpx;
  text-align: center;
  font-size: var(--fs-sub);
  line-height: 64rpx;
}

.save-btn + .save-btn {
  margin-left: 16rpx;
}

.save-btn.main {
  border-color: var(--yolk);
  background: var(--yolk);
  font-weight: 600;
}

.save-btn.disabled {
  border-color: var(--line);
  background: #fff;
  color: var(--text-3);
}

.step-btn.disabled {
  border-color: var(--line);
  background: #fff;
  color: var(--text-3);
}
