<view class="import">
  <view class="card">
    <view class="para">可以导入备份文件，或者照着导入模板写好的菜谱。同名的菜会跳过，不会重复。</view>
  </view>

  <view class="card">
    <view class="step">
      <view class="step-no">1</view>
      <view class="step-main">
        <view class="step-title">选要导入的内容</view>
        <view wx:if="{{file}}" class="step-desc">{{file.name}}</view>
      </view>
    </view>
    <view class="pick">
      <view class="pick-actions">
        <view class="pick-btn {{status === 'working' ? 'disabled' : ''}}" bindtap="onChoose">从微信聊天选文件</view>
        <view class="pick-btn {{status === 'working' ? 'disabled' : ''}}" bindtap="onPaste">粘贴复制的内容</view>
      </view>
      <view class="pick-help">
        <view>· 手机里的文件：在「文件」或文件管理里选中它，分享到微信「文件传输助手」，再回来选</view>
        <view>· 电脑上的文件：拖进电脑微信的「文件传输助手」，再回来选</view>
        <view>· 不想经过聊天：用备忘录、记事本打开文件，全选复制，再点「粘贴复制的内容」</view>
      </view>
    </view>

    <view wx:if="{{file}}" class="summary">
      <view class="row"><text>菜谱</text><text class="row-value">{{file.dishCount}} 道，新的 {{file.newCount}} 道</text></view>
      <view wx:if="{{file.skipNames.length}}" class="skip">已经有了、会跳过：{{file.skipText}}</view>
      <view class="row"><text>做菜记录</text><text class="row-value">{{file.logCount}} 条</text></view>
      <view class="row"><text>照片</text><text class="row-value">{{file.photoCount}} 张</text></view>
    </view>

    <view class="step">
      <view class="step-no">2</view>
      <view class="step-main">
        <view class="step-title">开始导入</view>
        <view wx:if="{{status === 'working'}}" class="step-desc">{{progress}}</view>
        <view wx:elif="{{status === 'done'}}" class="step-desc ok">导入了 {{result.added}} 道菜、{{result.logsAdded}} 条做菜记录{{result.skipped ? '，跳过 ' + result.skipped + ' 道已有的菜' : ''}}</view>
      </view>
      <view class="step-btn main {{status === 'ready' ? '' : 'disabled'}}" bindtap="onImport">导入</view>
    </view>
  </view>

  <view wx:if="{{status === 'done'}}" class="btn-primary go" bindtap="onGoMenu">去菜单看看</view>
</view>
