<view wx:if="{{form}}" class="log-edit">
  <view wx:if="{{inMeal}}" class="hint meal-tip">开饭时一起记的。这里改这道菜自己的照片、分数和心得，哪天吃的、整桌照片和这顿的心得在记录页那一顿的「改一改」里改</view>
  <!-- 成品照：点一下拍照或从相册选 -->
  <view class="photo-box" bindtap="onChoosePhoto" hover-class="tap-card" hover-stay-time="100">
    <cloud-image wx:if="{{form.photo}}" class="photo" src="{{form.photo}}" mode="aspectFill" />
    <view wx:else class="photo-empty">
      <image class="ic xl" src="/images/icons/camera-wood.png" />
      <text>拍一张成品照</text>
    </view>
    <view wx:if="{{form.photo}}" class="photo-actions">
      <view class="photo-btn">换一张</view>
      <view class="photo-btn" catchtap="onRemovePhoto" hover-class="tap" hover-stay-time="100" hover-stop-propagation>删除</view>
    </view>
  </view>

  <view class="card">
    <!-- 选菜：弹出可以搜索、按分类排好的面板（菜多了比滚轮好找） -->
    <view wx:if="{{!dishLocked}}" class="field" bindtap="onOpenDishPicker" hover-class="tap-row" hover-stay-time="100">
      <text class="label">做的菜</text>
      <text class="value {{dishName ? '' : 'placeholder'}}">{{dishName || '选一道菜'}}</text>
      <text class="arrow">›</text>
    </view>
    <view wx:else class="field">
      <text class="label">做的菜</text>
      <text class="value">{{dishName}}</text>
    </view>
    <!-- 日期：多数是今天、昨天，点一下就行；别的日子再打开日期选择。开饭时一起记的跟着那一顿 -->
    <view wx:if="{{!inMeal}}" class="field field-wrap">
      <text class="label">哪天做的</text>
      <view class="chips">
        <view class="chip {{form.date === today ? 'on' : ''}}" data-date="{{today}}" bindtap="onQuickDate" hover-class="tap" hover-stay-time="100">今天</view>
        <view class="chip {{form.date === yesterday ? 'on' : ''}}" data-date="{{yesterday}}" bindtap="onQuickDate" hover-class="tap" hover-stay-time="100">昨天</view>
        <picker mode="date" value="{{form.date}}" end="{{today}}" bindchange="onDateChange">
          <view class="chip {{form.date !== today && form.date !== yesterday ? 'on' : ''}}">{{form.date !== today && form.date !== yesterday ? form.date : '其他日子'}}</view>
        </picker>
      </view>
    </view>
    <view class="field">
      <text class="label">好吃程度</text>
      <view class="stars">
        <text wx:for="{{stars}}" wx:key="*this" class="star {{form.rating >= item ? 'on' : ''}}"
              data-value="{{item}}" bindtap="onStarTap">★</text>
        <text class="star-text">{{ratingLabels[form.rating]}}</text>
      </view>
    </view>
    <!-- 掌勺：以前写过的名字点一下就行 -->
    <view class="field field-wrap">
      <text class="label">掌勺</text>
      <view class="cook-box">
        <input class="input" value="{{form.cook}}" placeholder="谁做的" maxlength="10"
               data-field="cook" bindinput="onInput" />
        <view wx:if="{{cookNames.length}}" class="chips">
          <view wx:for="{{cookNames}}" wx:key="*this" class="chip {{form.cook === item ? 'on' : ''}}"
                data-name="{{item}}" bindtap="onPickCook" hover-class="tap" hover-stay-time="100">{{item}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">心得</view>
    <textarea class="text-input" value="{{form.note}}" placeholder="这次哪里好、哪里要改，比如：盐少放一点，番茄多炒一会儿"
              auto-height maxlength="-1" cursor-spacing="80" data-field="note" bindinput="onInput" />
  </view>

  <view wx:if="{{showCoverOption || showPlanOption}}" class="card">
    <view wx:if="{{showCoverOption}}" class="option" bindtap="onToggleCover" hover-class="tap-row" hover-stay-time="100">
      <view class="checkbox {{useAsCover ? 'on' : ''}}">{{useAsCover ? '✓' : ''}}</view>
      <text>用这张照片当这道菜的成品照</text>
    </view>
    <view wx:if="{{showPlanOption}}" class="option" bindtap="onTogglePlan" hover-class="tap-row" hover-stay-time="100">
      <view class="checkbox {{removeFromPlan ? 'on' : ''}}">{{removeFromPlan ? '✓' : ''}}</view>
      <text>从菜篮里拿掉这道菜</text>
    </view>
  </view>
</view>

<!-- 底部保存栏 -->
<view wx:if="{{form}}" class="save-bar">
  <view wx:if="{{isEdit}}" class="delete-btn" bindtap="onDelete" hover-class="tap" hover-stay-time="100">删除</view>
  <view class="btn-primary save-btn" bindtap="onSave" hover-class="tap" hover-stay-time="100">{{isEdit ? '保存' : '打卡'}}</view>
</view>

<dish-picker show="{{showDishPicker}}" selected="{{form.dishId}}" bind:select="onDishPicked" bind:close="onCloseDishPicker" />
