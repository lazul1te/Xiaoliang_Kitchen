/* 底部留出保存栏的高度 */
.log-edit {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ---------- 成品照 ---------- */

.photo-box {
  position: relative;
  height: 400rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--apricot);
}

.photo {
  display: block;
  width: 100%;
  height: 100%;
}

.photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-size: 26rpx;
  color: var(--wood);
}


.photo-actions {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
}

.photo-btn {
  margin-left: 12rpx;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(59, 59, 66, 0.72);
  font-size: 22rpx;
  color: #fff;
}

/* ---------- 表单 ---------- */

.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 2rpx solid var(--line);
}

.card > .field:last-child {
  border-bottom: none;
}

.label {
  flex-shrink: 0;
  width: 150rpx;
  font-size: 28rpx;
  color: var(--text-2);
}

.value {
  flex: 1;
  font-size: 28rpx;
}

/* 选项会换行的一行（日期、掌勺）：标签靠上 */
.field-wrap {
  align-items: flex-start;
  padding: 10rpx 0;
}

.field-wrap .label {
  padding-top: 14rpx;
}

.field-wrap .chips {
  flex: 1;
  padding: 0;
}

.cook-box {
  flex: 1;
}

.cook-box .input {
  height: 72rpx;
}

.cook-box .chips {
  padding-bottom: 8rpx;
}

.value.placeholder {
  color: var(--text-3);
}

.arrow {
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-3);
}

.input {
  flex: 1;
  height: 92rpx;
  font-size: 28rpx;
}

.stars {
  display: flex;
  align-items: center;
}

.star {
  padding: 0 6rpx;
  font-size: 40rpx;
  color: #e6dccd;
}

.star.on {
  color: var(--yolk);
}

.star-text {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.text-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--cream);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 勾选项 */
.option {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.checkbox {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border: 3rpx solid #d9cfc1;
  border-radius: 10rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: var(--pan);
}

.checkbox.on {
  border-color: var(--yolk);
  background: var(--yolk);
}

/* ---------- 底部保存栏 ---------- */

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(59, 59, 66, 0.06);
}

.delete-btn {
  flex-shrink: 0;
  width: 120rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--danger);
}

.save-btn {
  flex: 1;
}

.meal-tip {
  margin: 20rpx 32rpx 0;
}
