<!-- 一条做菜记录 -->
<template name="logCard">
  <view class="log-card" data-id="{{_id}}" bindtap="onOpenLog">
    <cloud-image wx:if="{{photo}}" class="log-photo" src="{{photo}}" mode="aspectFill" />
    <view wx:else class="log-photo log-photo-empty">{{initial}}</view>
    <view class="log-info">
      <view class="log-head">
        <text class="log-dish">{{dishName}}</text>
        <text wx:if="{{stars}}" class="log-stars">{{stars}}</text>
      </view>
      <view wx:if="{{note}}" class="log-note">{{note}}</view>
      <view wx:if="{{cook}}" class="log-cook">掌勺：{{cook}}</view>
    </view>
  </view>
</template>

<!-- 一顿饭（开饭时一起记的）：整桌照片、哪一顿、每道菜的分数 -->
<template name="mealCard">
  <view class="meal-card">
    <cloud-image wx:if="{{photo}}" class="meal-photo" src="{{photo}}" mode="aspectFill" />
    <view class="meal-body">
      <view class="meal-head">
        <text class="meal-title">{{title}}</text>
        <text wx:if="{{noText}}" class="meal-no">{{noText}}</text>
        <text wx:if="{{peopleText}}" class="meal-people">{{peopleText}}</text>
      </view>
      <view wx:for="{{dishes}}" wx:key="_id" class="meal-dish" data-id="{{item._id}}" bindtap="onOpenLog">
        <text class="meal-dish-name">{{item.dishName}}<text wx:if="{{item.qtyText}}" class="meal-qty"> {{item.qtyText}}</text></text>
        <text wx:if="{{item.stars}}" class="meal-stars">{{item.stars}}</text>
      </view>
      <view wx:if="{{note}}" class="meal-note">{{note}}</view>
      <view class="meal-acts">
        <text class="meal-act pri" data-id="{{_id}}" bindtap="onReorder">再来一单</text>
        <text class="meal-act" data-id="{{_id}}" bindtap="onShareMeal">分享这顿饭</text>
      </view>
    </view>
  </view>
</template>

<view wx:if="{{loaded}}" class="logs">
  <!-- 做饭日历 -->
  <view class="card calendar">
    <view class="cal-head">
      <text class="cal-arrow hit" bindtap="onPrevMonth">‹</text>
      <view class="cal-title">{{cal.title}}</view>
      <text class="cal-arrow hit" bindtap="onNextMonth">›</text>
    </view>
    <view class="cal-summary">{{calSummary}}</view>
    <view class="cal-row cal-week">
      <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text>
    </view>
    <view wx:for="{{cal.weeks}}" wx:key="key" wx:for-item="week" class="cal-row">
      <view wx:for="{{week.days}}" wx:key="key" wx:for-item="d"
            class="cal-day {{d.count ? 'cooked' : ''}} {{d.isToday ? 'today' : ''}} {{d.isFuture ? 'future' : ''}} {{d.date && d.date === selected ? 'selected' : ''}}"
            data-date="{{d.date}}" data-count="{{d.count}}" data-future="{{d.isFuture}}" bindtap="onTapDay">
        <text class="cal-num">{{d.day}}</text>
        <text wx:if="{{d.count}}" class="cal-dot">{{d.count > 1 ? d.count + '道' : '●'}}</text>
      </view>
    </view>
    <view class="cal-stats">一共下厨 {{stats.total}} 次 · 做过 {{stats.dishCount}} 道不同的菜 · 点日子看那天</view>
  </view>

  <!-- 选中某一天 -->
  <block wx:if="{{selected}}">
    <view class="day-bar">
      <text class="day-bar-title">{{dayTitle}}</text>
      <text class="day-bar-all" bindtap="onShowAll">看全部</text>
    </view>
    <view class="add-log" data-date="{{selected}}" bindtap="onAddLog">＋ 这天再记一道</view>
    <block wx:for="{{dayEntries}}" wx:key="key" wx:for-item="entry">
      <template wx:if="{{entry.type === 'meal'}}" is="mealCard" data="{{...entry.meal}}" />
      <template wx:else is="logCard" data="{{...entry.log}}" />
    </block>
  </block>

  <!-- 全部记录 -->
  <block wx:else>
    <view class="add-log" bindtap="onAddLog">＋ 记一笔</view>
    <view wx:if="{{!months.length}}" class="empty small">
      <view class="empty-emoji">📒</view>
      <view class="empty-title">还没有做菜记录</view>
      <view class="empty-desc">在菜谱详情页点「开始做」，做完打个卡；以前做过的，点日历上那天补记</view>
    </view>
    <view wx:for="{{months}}" wx:key="key" wx:for-item="month" class="month">
      <view class="month-title">{{month.title}}<text class="month-count"> · 下厨 {{month.count}} 次</text></view>
      <view wx:for="{{month.days}}" wx:key="key" wx:for-item="day" class="day">
        <view class="day-title">{{day.title}}</view>
        <block wx:for="{{day.entries}}" wx:key="key" wx:for-item="entry">
          <template wx:if="{{entry.type === 'meal'}}" is="mealCard" data="{{...entry.meal}}" />
          <template wx:else is="logCard" data="{{...entry.log}}" />
        </block>
      </view>
    </view>
    <view wx:if="{{months.length}}" class="list-end">— 下拉可以刷新 —</view>
  </block>
</view>

<!-- 画「分享这顿饭」图片用的画布，不显示出来 -->
<canvas type="2d" id="ticket-canvas" class="ticket-canvas"></canvas>
