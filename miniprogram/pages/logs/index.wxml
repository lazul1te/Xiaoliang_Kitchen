<!-- 一条做菜记录（开饭时记的也一样）。fresh：刚开完饭，盖个「已开饭」的章 -->
<template name="logCard">
  <view class="log-card" data-id="{{_id}}" bindtap="onOpenLog" hover-class="tap-card" hover-stay-time="100">
    <cloud-image wx:if="{{photo}}" class="log-photo" src="{{photo}}" mode="aspectFill" />
    <view wx:else class="log-photo log-photo-empty">{{initial}}</view>
    <view wx:if="{{fresh}}" class="log-stamp">已开饭</view>
    <view class="log-info">
      <view class="log-head">
        <text class="log-dish">{{dishName}}</text>
        <text wx:if="{{stars}}" class="log-stars">{{stars}}</text>
      </view>
      <view wx:if="{{note}}" class="log-note">{{note}}</view>
      <view wx:if="{{cook}}" class="log-cook">掌勺：{{cook}}</view>
    </view>
  </view>
</template>

<view wx:if="{{loaded}}" class="logs">
  <!-- 做饭日历：默认收起，只显示一周；展开看整月，左右滑换月。下厨几次、最常做什么在右上角的「总结」里 -->
  <view class="card calendar">
    <view class="cal-head">
      <view wx:if="{{calOpen}}" class="cal-arrow hit" bindtap="onPrevMonth" hover-class="tap" hover-stay-time="100">‹</view>
      <view class="cal-title">{{cal.title}}</view>
      <view wx:if="{{calOpen}}" class="cal-arrow hit" bindtap="onNextMonth" hover-class="tap" hover-stay-time="100">›</view>
      <view class="pill cal-sum" bindtap="onOpenStats" hover-class="tap" hover-stay-time="100"><image class="ic sm" src="/images/icons/stats.png" />总结</view>
    </view>
    <view class="cal-grid {{calAnim}}" bindtouchstart="onCalTouchStart" bindtouchend="onCalTouchEnd">
      <view class="cal-row cal-week">
        <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text>
      </view>
      <view wx:for="{{weeks}}" wx:key="key" wx:for-item="week" class="cal-row">
        <view wx:for="{{week.days}}" wx:key="key" wx:for-item="d"
              class="cal-day {{d.count ? 'cooked' : ''}} {{d.isToday ? 'today' : ''}} {{d.isFuture ? 'future' : ''}} {{d.date && d.date === selected ? 'selected' : ''}}"
              data-date="{{d.date}}" data-count="{{d.count}}" data-future="{{d.isFuture}}" bindtap="onTapDay" hover-class="tap" hover-stay-time="100">
          <text class="cal-num">{{d.day}}</text>
          <text wx:if="{{d.count}}" class="cal-dot">{{d.count > 1 ? d.count + '道' : '●'}}</text>
        </view>
      </view>
    </view>
    <view class="cal-toggle" bindtap="onToggleCalendar" hover-class="tap" hover-stay-time="100">
      <text>{{calOpen ? '收起' : '展开整月'}}</text>
      <view class="cal-caret {{calOpen ? 'up' : ''}}"></view>
    </view>
  </view>

  <!-- 选中某一天 -->
  <block wx:if="{{selected}}">
    <view class="day-bar">
      <text class="day-bar-title">{{dayTitle}}</text>
      <text class="day-bar-all" bindtap="onShowAll">看全部</text>
    </view>
    <view class="add-log" data-date="{{selected}}" bindtap="onAddLog" hover-class="tap" hover-stay-time="100">＋ 这天再记一道</view>
    <block wx:for="{{dayLogs}}" wx:key="_id">
      <template is="logCard" data="{{...item}}" />
    </block>
  </block>

  <!-- 全部记录 -->
  <block wx:else>
    <view class="add-log" bindtap="onAddLog" hover-class="tap" hover-stay-time="100">＋ 记一笔</view>
    <view wx:if="{{!months.length}}" class="empty small">
      <image class="empty-img" src="/images/empty/book.png" />
      <view class="empty-title">还没有做菜记录</view>
      <view class="empty-desc">在菜谱详情页点「开始做」，做完打个卡；以前做过的，点日历上那天补记</view>
    </view>
    <view wx:for="{{months}}" wx:key="key" wx:for-item="month" class="month">
      <view class="month-title">{{month.title}}<text class="month-count"> · 下厨 {{month.count}} 次</text></view>
      <view wx:for="{{month.days}}" wx:key="key" wx:for-item="day" class="day">
        <view class="day-title">{{day.title}}</view>
        <block wx:for="{{day.logs}}" wx:key="_id">
          <template is="logCard" data="{{...item}}" />
        </block>
      </view>
    </view>
    <view wx:if="{{months.length}}" class="list-end">— 下拉可以刷新 —</view>
  </block>
</view>

<!-- 第一次读取：灰色占位（日历 + 几条记录） -->
<view wx:else class="sk-page">
  <view class="sk-card">
    <view class="sk sk-bar w30"></view>
    <view class="sk sk-bar"></view>
    <view class="sk sk-bar"></view>
  </view>
  <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="sk-card">
    <view class="sk sk-bar w60"></view>
    <view class="sk sk-bar"></view>
  </view>
</view>
