.menu-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ---------- 顶部 ---------- */

.header {
  flex-shrink: 0;
  padding: 16rpx 24rpx 20rpx;
}

.search-row {
  display: flex;
  align-items: center;
}

/* 左上角：正在用的小本本 */
.book-chip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-right: 16rpx;
  padding: 0 16rpx 0 14rpx;
  border-radius: 36rpx;
  background: #fff;
}

.book-chip-name {
  max-width: 132rpx;
  margin-left: 8rpx;
  overflow: hidden;
  font-size: var(--fs-sub);
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.book-chip-caret {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 36rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  margin: 0 12rpx;
  font-size: 26rpx;
}

.search-placeholder {
  color: var(--text-3);
}


.add-btn {
  flex-shrink: 0;
  height: 72rpx;
  margin-left: 16rpx;
  padding: 0 26rpx;
  border-radius: 36rpx;
  background: var(--yolk);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

/* ---------- 搜索结果 ---------- */

.search-list {
  flex: 1;
  height: 0;
  padding: 0 24rpx;
}

.search-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: var(--fs-sub);
  color: var(--text-3);
}

.search-wish {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: #fff;
  font-size: var(--fs-sub);
  color: var(--pan);
}

/* ---------- 左分类 + 右菜品 ---------- */

.body {
  flex: 1;
  height: 0;
  display: flex;
}

.is-hidden {
  display: none !important;
}

/* 读取中 / 读取失败 / 第一次用 */
.state {
  flex: 1;
  padding: 120rpx 56rpx 0;
  text-align: center;
}

/* 加载占位：分类栏的灰条、菜品卡片的灰块 */
.sk-cat {
  padding: 32rpx 28rpx;
}

.sk-cat-bar {
  height: 28rpx;
}

.sk-title {
  width: 120rpx;
  height: 26rpx;
  margin: 24rpx 4rpx 18rpx;
}

.sk-line {
  height: 28rpx;
  margin-top: 8rpx;
}

.sk-line.short {
  width: 50%;
  margin-top: 20rpx;
}

.state .btn-primary,
.state .btn-outline {
  width: 440rpx;
  margin: 40rpx auto 0;
}

.state .btn-outline {
  margin-top: 24rpx;
}

.state-hint {
  margin-top: 48rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}

.cat-list {
  flex-shrink: 0;
  width: 168rpx;
  height: 100%;
  background: #fbeedb;
}

.cat-item {
  position: relative;
  padding: 32rpx 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
}

.cat-item.active {
  background: var(--cream);
  color: var(--pan);
  font-weight: 600;
}

/* 选中分类左边的小黄条 */
.cat-item.active::before {
  content: "";
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 0;
  width: 8rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: var(--yolk);
}

.cat-count {
  position: absolute;
  top: 12rpx;
  right: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--yolk);
  color: var(--pan);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.dish-list {
  flex: 1;
  height: 100%;
  padding: 0 20rpx;
}

.section-title {
  padding: 20rpx 4rpx 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
}

.section-empty {
  padding: 20rpx 4rpx 30rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.section-add {
  color: var(--wood);
}

.list-end {
  padding: 24rpx 0 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---------- 底部点菜栏 ---------- */

.basket-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  margin: 12rpx 24rpx 16rpx;
  padding: 0 12rpx 0 32rpx;
  border-radius: 52rpx;
  background: var(--pan);
}

.basket-info {
  display: flex;
  align-items: center;
}

.basket-icon {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  opacity: 0.45;
}

.basket-img {
  display: block;
  width: 60rpx;
  height: 60rpx;
}

.basket-icon.on {
  opacity: 1;
}

.basket-num {
  position: absolute;
  top: -12rpx;
  right: -20rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: var(--yolk);
  color: var(--pan);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.basket-text {
  margin-left: 32rpx;
  font-size: 28rpx;
  color: #fff;
}

.basket-go {
  height: 80rpx;
  padding: 0 44rpx;
  border-radius: 40rpx;
  background: var(--yolk);
  color: var(--pan);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.basket-go.disabled {
  background: #55555d;
  color: #8e8e96;
}

/* ---------- 菜篮（底部弹出来） ---------- */

.cart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.cart-clear {
  font-size: var(--fs-small);
  color: var(--text-3);
}

.cart-hint {
  margin-bottom: 8rpx;
}

.cart-list {
  max-height: 55vh;
}

.cart-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.cart-thumb {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
}

.cart-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--apricot);
  color: var(--wood);
  font-size: 32rpx;
  font-weight: 700;
}

.cart-name {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx 0 20rpx;
  overflow: hidden;
  font-size: var(--fs-body);
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cart-added {
  margin-left: 8rpx;
  font-size: var(--fs-tiny);
  font-weight: 700;
  color: var(--wood);
}

.cart-go {
  margin-top: 24rpx;
}
