<view class="mine">
  <view class="profile">
    <image class="logo" src="/images/logo.png" />
    <view class="profile-text">
      <view class="app-name">拿手菜小本本</view>
      <view class="app-slogan">好好做饭，也好好记录</view>
    </view>
  </view>

  <view class="card stats">
    <view class="stat">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-label">道菜</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{stats.mastered}}</view>
      <view class="stat-label">拿手菜</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{stats.cooked}}</view>
      <view class="stat-label">次下厨</view>
    </view>
  </view>

  <view class="card settings">
    <view class="setting-item" bindtap="onOpenWishes">
      <text>💭 想吃清单</text>
      <view class="setting-right">
        <text wx:if="{{wishCount}}" class="setting-note">{{wishCount}} 个</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="setting-item" bindtap="onOpenPantry">
      <text>🧂 家里的库存</text>
      <view class="setting-right">
        <text wx:if="{{outCount}}" class="setting-note warn">{{outCount}} 样用完了</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card settings">
    <view class="setting-item" bindtap="onOpenCategories">
      <text>分类管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onOpenExport">
      <text>数据导出</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onOpenImport">
      <text>数据导入</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onCheckDatabase">
      <text>检查云数据库</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{sampleCount}}" class="card sample">
    <view class="sample-text">菜单里还有 {{sampleCount}} 道示例菜，开始记自己的菜以后可以一起删掉。</view>
    <view class="sample-btn" bindtap="onRemoveSamples">删除示例菜</view>
  </view>

  <view class="version">两个人共用一本菜谱，都能看、都能改</view>
</view>
