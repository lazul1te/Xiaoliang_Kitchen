.mine {
  padding-bottom: 40rpx;
}

.profile {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx 16rpx;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.profile-text {
  margin-left: 28rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: 700;
}

.app-slogan {
  margin-top: 4rpx;
  font-size: var(--fs-small);
  color: var(--text-2);
}

.stats {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: var(--fs-xl);
  font-weight: 700;
}

.stat-label {
  font-size: var(--fs-small);
  color: var(--text-3);
}

/* 常用的两个大方块 */
.tiles {
  display: flex;
  margin: 20rpx 24rpx 0;
}

.tile {
  flex: 1;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.tile + .tile {
  margin-left: 20rpx;
}

.tile-icon {
  display: block;
  width: 56rpx;
  height: 56rpx;
}

.tile-name {
  margin-top: 16rpx;
  font-size: var(--fs-body);
  font-weight: 600;
}

.tile-note {
  margin-top: 4rpx;
  font-size: var(--fs-small);
  color: var(--text-3);
}

.tile-note.warn {
  color: var(--danger);
}

.settings {
  padding-top: 0;
  padding-bottom: 0;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  font-size: var(--fs-body);
}

.setting-name {
  flex: 1;
}

.setting-item + .setting-item {
  border-top: 2rpx solid var(--line);
}




.arrow {
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-3);
}

.sample {
  display: flex;
  align-items: center;
}

.sample-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
}

.sample-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 24rpx;
  border: 2rpx solid var(--danger);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--danger);
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: var(--fs-tiny);
  line-height: 1.8;
  color: var(--text-3);
}

.footer-link {
  display: inline-block;
  margin-top: 8rpx;
  color: var(--text-2);
  text-decoration: underline;
}
