.mine {
  padding-bottom: 40rpx;
}

/* 最上面：正在用的小本本 */
.book-card {
  margin-top: 24rpx;
}

.bc-top {
  display: flex;
  align-items: center;
}

.bc-text {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.bc-name {
  display: flex;
  align-items: baseline;
  font-size: 34rpx;
  font-weight: 700;
}

.bc-name-t {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bc-caret {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
}

.bc-sub {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: var(--fs-small);
  color: var(--text-3);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bc-req {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #fdeceb;
  font-size: var(--fs-sub);
  color: var(--danger);
}

.bc-acts {
  display: flex;
  margin-top: 24rpx;
}

/* 「邀请家人」是 <button open-type="share">，去掉按钮自带的样式（多写一层 .bc-acts 才压得住） */
.bc-acts .bc-act {
  width: auto;
  height: 60rpx;
  margin: 0 16rpx 0 0;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: var(--cream);
  color: var(--pan);
  font-size: var(--fs-small);
  font-weight: 600;
  line-height: 60rpx;
}

.bc-acts .bc-act.on {
  background: var(--yolk);
}

.stats {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: var(--fs-xl);
  font-weight: 700;
}

.stat-label {
  font-size: var(--fs-small);
  color: var(--text-3);
}

/* 常用的两个大方块 */
.tiles {
  display: flex;
  margin: 20rpx 24rpx 0;
}

.tile {
  flex: 1;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.tile + .tile {
  margin-left: 20rpx;
}

.tile-icon {
  display: block;
  width: 56rpx;
  height: 56rpx;
}

.tile-name {
  margin-top: 16rpx;
  font-size: var(--fs-body);
  font-weight: 600;
}

.tile-note {
  margin-top: 4rpx;
  font-size: var(--fs-small);
  color: var(--text-3);
}

.tile-note.warn {
  color: var(--danger);
}

.settings {
  padding-top: 0;
  padding-bottom: 0;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  font-size: var(--fs-body);
}

.setting-name {
  flex: 1;
}

.setting-item + .setting-item {
  border-top: 2rpx solid var(--line);
}




.arrow {
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-3);
}

.sample {
  display: flex;
  align-items: center;
}

.sample-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
}

.sample-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 24rpx;
  border: 2rpx solid var(--danger);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--danger);
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: var(--fs-tiny);
  line-height: 1.8;
  color: var(--text-3);
}

.footer-link {
  display: inline-block;
  margin-top: 8rpx;
  color: var(--text-2);
  text-decoration: underline;
}
