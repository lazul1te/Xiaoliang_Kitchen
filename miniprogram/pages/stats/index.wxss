.body {
  padding-bottom: 48rpx;
}

.body .empty {
  padding: 80rpx 48rpx;
}

/* ---------- 最上面：按月 / 按年 / 全部，往前往后翻 ---------- */

.top {
  padding: 20rpx 24rpx 0;
}

.seg {
  display: flex;
  padding: 6rpx;
  border-radius: 36rpx;
  background: #f3e8d8;
}

.seg-item {
  flex: 1;
  height: 60rpx;
  border-radius: 30rpx;
  text-align: center;
  font-size: var(--fs-sub);
  line-height: 60rpx;
  color: var(--text-2);
  transition: background-color 0.2s, color 0.2s;
}

.seg-item.on {
  background: #fff;
  color: var(--pan);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(59, 59, 66, 0.08);
}

.period {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.period-title {
  min-width: 240rpx;
  text-align: center;
  font-size: var(--fs-title);
  font-weight: 700;
}

.period-arrow {
  width: 72rpx;
  text-align: center;
  font-size: 44rpx;
  line-height: 1;
  color: var(--text-2);
}

/* 没有更早的记录、还没到的日子：箭头灰掉 */
.period-arrow.off {
  color: #d6d6db;
}

/* ---------- 三个数字 ---------- */

.nums {
  display: flex;
}

.num {
  flex: 1;
  text-align: center;
}

.num-v {
  font-size: var(--fs-xl);
  font-weight: 700;
  line-height: 1.3;
}

.num-k {
  font-size: var(--fs-small);
  color: var(--text-3);
}

/* ---------- 最常做的菜 ---------- */

.rank {
  display: flex;
  align-items: center;
  margin: 0 -12rpx;
  padding: 14rpx 12rpx;
  border-radius: 12rpx;
}

.rank-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--cream);
  text-align: center;
  font-size: var(--fs-tiny);
  font-weight: 700;
  line-height: 40rpx;
  color: var(--text-2);
}

.rank-no.first {
  background: var(--yolk);
  color: var(--pan);
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.rank-name {
  min-width: 0;
  overflow: hidden;
  font-size: var(--fs-body);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rank-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-small);
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.bar {
  height: 10rpx;
  margin-top: 10rpx;
  border-radius: 5rpx;
  background: #f6ecdd;
}

.bar-fill {
  height: 100%;
  border-radius: 5rpx;
  background: var(--yolk);
}

/* ---------- 谁掌勺 ---------- */

.split {
  display: flex;
  height: 20rpx;
  overflow: hidden;
  border-radius: 10rpx;
}

.split-part + .split-part {
  margin-left: 4rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 4rpx 32rpx 4rpx 0;
  font-size: var(--fs-small);
  color: var(--text-2);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 10rpx;
  border-radius: 50%;
}

/* ---------- 打分最高、好久没做了：一行一道 ---------- */

.row {
  display: flex;
  align-items: center;
  margin: 0 -12rpx;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
}

.row-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: var(--fs-body);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.best-stars {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--yolk);
}

.row-note {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-small);
  color: var(--text-3);
}

.row .arrow {
  margin-left: 12rpx;
  color: var(--text-3);
}

/* ---------- 每个月下厨几次 ---------- */

.chart {
  display: flex;
  align-items: flex-end;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.col-n {
  height: 32rpx;
  font-size: var(--fs-tiny);
  line-height: 32rpx;
  color: var(--text-2);
}

.col-track {
  display: flex;
  align-items: flex-end;
  width: 28rpx;
  height: 160rpx;
}

.col-bar {
  width: 100%;
  min-height: 4rpx;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  background: #efe4d3;
}

.col-bar.has {
  background: var(--yolk);
}

.col-k {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* 这个月：月份写深一点 */
.col.now .col-k {
  color: var(--pan);
  font-weight: 700;
}
