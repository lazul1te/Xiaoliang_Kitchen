<!-- 菜篮里的一道菜（只能看，加减在菜单页底部的菜篮里）：缩略图、名字、用时、份数 -->
<template name="orderRow">
  <view class="o-row" data-id="{{_id}}" bindtap="onOpenDish" hover-class="tap-row" hover-stay-time="100">
    <cloud-image wx:if="{{cover && !broken}}" class="o-thumb" src="{{cover}}" mode="aspectFill"
                 data-src="{{cover}}" binderror="onCoverError" />
    <view wx:else class="o-thumb o-thumb-empty">{{initial}}</view>
    <view class="o-info">
      <view class="o-name">{{name}}</view>
      <view wx:if="{{meta}}" class="o-meta">{{meta}}</view>
    </view>
    <text class="o-qty">×{{qty}}</text>
  </view>
</template>

<!-- 买菜清单的一行：点一下就是买到了 / 没买到。action：have 右边显示「家里有」，remove 显示删除 -->
<template name="shopRow">
  <view class="shop-row {{checked ? 'done' : ''}}" data-key="{{key}}" bindtap="onToggleItem" hover-class="tap-row" hover-stay-time="100">
    <view class="check {{pop ? 'pop' : ''}}">{{checked ? '✓' : ''}}</view>
    <view class="shop-main">
      <view class="shop-line">
        <text class="shop-name">{{name}}</text>
        <text wx:if="{{amountText}}" class="shop-amount">{{amountText}}</text>
      </view>
      <view wx:if="{{dishesText || outOfStock}}" class="shop-dishes">
        <text wx:if="{{outOfStock}}" class="shop-flag">家里用完了</text>{{dishesText}}
      </view>
    </view>
    <view wx:if="{{action === 'have'}}" class="pill shop-act" data-name="{{name}}" catchtap="onHaveIt" hover-class="tap" hover-stay-time="100" hover-stop-propagation>家里有</view>
    <view wx:if="{{action === 'remove'}}" class="shop-remove" data-key="{{key}}" catchtap="onRemoveExtra" hover-class="tap" hover-stay-time="100" hover-stop-propagation>×</view>
  </view>
</template>

<view wx:if="{{stage === 'empty'}}" class="empty">
  <image class="empty-img" src="/images/empty/basket.png" />
  <view class="empty-title">还没点菜</view>
  <view class="empty-desc">{{shared ? '去菜单里挑几道想做的菜，家人点的也会放进菜篮' : '去菜单里挑几道想做的菜'}}</view>
  <view class="btn-primary" bindtap="onGoMenu" hover-class="tap" hover-stay-time="100">去点菜</view>
  <view class="empty-orders" bindtap="onOpenOrders" hover-class="tap" hover-stay-time="100">以前的点菜单 ›</view>
</view>

<view wx:else class="today {{(stage === 'picking' && items.length) || stage === 'ordered' ? 'has-bar' : ''}}">
  <view class="top-row">
    <text class="top-title">{{stage === 'ordered' ? '这顿的点菜单' : '还没下单'}}</text>
    <text class="top-link" bindtap="onOpenOrders">点菜单记录 ›</text>
  </view>

  <!-- 一起做到一半退出了：接着做 -->
  <view wx:if="{{cooking}}" class="banner">
    <text class="banner-text">正在一起做：{{cooking.done}}/{{cooking.total}} 道做好了</text>
    <view class="banner-acts">
      <view class="pill pri banner-btn" bindtap="onStartCook" hover-class="tap" hover-stay-time="100">继续做菜</view>
      <view class="pill banner-btn" bindtap="onDropCooking" hover-class="tap" hover-stay-time="100">不做了</view>
    </view>
  </view>

  <!-- ========== 下单以后：点菜单 ========== -->
  <block wx:if="{{stage === 'ordered'}}">
    <!-- 点菜单上的日子过了还没开饭：问一下做了没有 -->
    <view wx:if="{{overdue}}" class="banner">
      <text class="banner-text">{{overdue}}</text>
      <view class="banner-acts">
        <view class="pill pri banner-btn" bindtap="onOverdueDone" hover-class="tap" hover-stay-time="100">做了，记一下</view>
        <view class="pill banner-btn" bindtap="onCancelOrder" hover-class="tap" hover-stay-time="100">没做，撤单</view>
      </view>
    </view>
    <view class="ticket">
      <view class="t-top"><text>拿手菜小本本</text><text>{{ticket.dateText}}</text></view>
      <view class="t-title"><text class="t-name">点菜单</text><text class="t-no">{{ticket.noText}}</text></view>
      <view class="t-sub">{{ticket.meal}}{{ticket.peopleText ? ' · ' + ticket.peopleText : ''}}</view>
      <view class="t-items">
        <view wx:for="{{ticket.items}}" wx:key="_id" class="t-item" data-id="{{item._id}}" bindtap="onOpenDish" hover-class="tap-row" hover-stay-time="100">
          <view class="t-dish">{{item.name}}<text wx:if="{{item.added}}" class="t-added">加</text></view>
          <text class="t-qty">×{{item.qty}}</text>
        </view>
      </view>
      <view class="t-note">共 {{ticket.count}} 道菜 {{ticket.portions}} 份{{ticket.slowText ? ' · ' + ticket.slowText : ''}}</view>
      <view wx:if="{{ticket.flavorsText}}" class="t-note">口味：{{ticket.flavorsText}}</view>
      <view wx:if="{{ticket.note}}" class="t-note">备注：{{ticket.note}}</view>
      <view class="t-stamp {{stampIn ? 'stamp-in' : ''}}">已下单</view>
    </view>
    <view class="t-actions">
      <button class="t-act pri" open-type="share">发给 TA</button>
      <view class="t-act" bindtap="onSaveImage" hover-class="tap" hover-stay-time="100">存成图片</view>
      <view class="t-act" bindtap="onAddMore" hover-class="tap" hover-stay-time="100">加菜</view>
      <view class="t-act" bindtap="onEditOrder" hover-class="tap" hover-stay-time="100">改一改</view>
    </view>
  </block>

  <!-- ========== 点了菜，还没下单 ========== -->
  <view wx:elif="{{items.length}}" class="card">
    <view class="o-head">
      <text class="o-title">菜篮里 {{items.length}} 道 · {{count}} 份</text>
      <text class="o-link hit" bindtap="onGoMenu">回菜单改 ›</text>
    </view>
    <block wx:for="{{items}}" wx:key="_id">
      <template is="orderRow" data="{{...item, broken: broken[item.cover]}}" />
    </block>
    <view class="o-tip">选好了就去下单：定哪一顿、口味，谁点的、谁掌勺</view>
  </view>

  <!-- 只剩自己加的要买的东西，还没点菜 -->
  <view wx:else class="card o-nodish">
    <text>还没点菜。</text><text class="o-link" bindtap="onGoMenu">去菜单点几道 ›</text>
  </view>

  <!-- ========== 买菜清单（下单前先收起来） ========== -->
  <view class="card shopping">
    <view class="shopping-head">
      <view class="shopping-title"><image class="ic lg" src="/images/icons/cart.png" />买菜清单</view>
      <text class="shopping-progress">已买 {{shopping.done}}/{{shopping.total}}</text>
      <view class="shop-copy hit" bindtap="onCopyList" hover-class="tap" hover-stay-time="100"><image class="ic sm" src="/images/icons/copy-gray.png" />复制</view>
    </view>
    <block wx:if="{{stage === 'ordered' || showShopping || !items.length}}">
      <view class="shopping-hint">按菜谱用量 × 份数算好了，家里有的不用买。买到一样点一下{{shared ? '，家人也能看到' : ''}}；点「复制」可以发到微信里</view>

      <view wx:if="{{shopping.buy.length}}" class="shop-group">
        <view class="shop-label">要买的</view>
        <block wx:for="{{shopping.buy}}" wx:key="key">
          <template is="shopRow" data="{{...item, action: 'have'}}" />
        </block>
      </view>

      <view wx:if="{{shopping.unknown.length}}" class="shop-group">
        <view class="shop-label-row">
          <text class="shop-label">调料：家里有的点「家里有」，以后就不提醒了</text>
          <text class="shop-all" bindtap="onHaveAll">都有</text>
        </view>
        <block wx:for="{{shopping.unknown}}" wx:key="key">
          <template is="shopRow" data="{{...item, action: 'have'}}" />
        </block>
      </view>

      <view class="shop-group">
        <view class="shop-label">自己加的</view>
        <block wx:for="{{shopping.extras}}" wx:key="key">
          <template is="shopRow" data="{{...item, action: 'remove'}}" />
        </block>
        <view class="shop-add" bindtap="onAddExtra" hover-class="tap" hover-stay-time="100">＋ 加一样（比如：牛奶、纸巾）</view>
      </view>

      <view wx:if="{{shopping.stocked.length}}" class="shop-group">
        <view class="shop-label-row" bindtap="onToggleStocked" hover-class="tap-row" hover-stay-time="100">
          <text class="shop-label">家里有的 {{shopping.stocked.length}} 样，不用买</text>
          <text class="shop-all">{{showStocked ? '收起' : '展开'}}</text>
        </view>
        <block wx:if="{{showStocked}}">
          <view wx:for="{{shopping.stocked}}" wx:key="key" class="stock-row">
            <text class="stock-name">{{item.name}}</text>
            <text class="stock-amount">{{item.amountText}}</text>
            <view class="pill shop-act" data-key="{{item.key}}" bindtap="onRanOut" hover-class="tap" hover-stay-time="100">用完了</view>
          </view>
        </block>
      </view>

      <view class="pantry-link" bindtap="onOpenPantry" hover-class="tap" hover-stay-time="100">管理家里的库存 ›</view>
      <view wx:if="{{stage === 'picking' && items.length}}" class="shop-fold-up" bindtap="onToggleShopping" hover-class="tap-row" hover-stay-time="100">收起买菜清单</view>
    </block>
    <view wx:else class="shop-fold" bindtap="onToggleShopping" hover-class="tap-row" hover-stay-time="100">
      <text>要买 {{shopping.total - shopping.done}} 样，下单以后照着买</text>
      <text class="shop-all">展开</text>
    </view>
  </view>

</view>

<!-- 还没下单：去下单（确认点菜单） -->
<view wx:if="{{stage === 'picking' && items.length}}" class="order-bar">
  <text class="order-bar-text">{{slowText || '共 ' + count + ' 份'}}</text>
  <view class="btn-primary order-btn" bindtap="onGoCheckout" hover-class="tap" hover-stay-time="100">去下单</view>
</view>

<!-- 下单以后：买齐了就开始做（几道菜一起做），做好了开饭 -->
<view wx:if="{{stage === 'ordered'}}" class="order-bar">
  <text class="order-bar-link" bindtap="onFinishMeal">做好了，开饭</text>
  <view class="btn-primary order-btn" bindtap="onStartCook" hover-class="tap" hover-stay-time="100">{{cooking ? '继续做菜' : '开始做菜（' + items.length + ' 道）'}}</view>
</view>

<!-- 画点菜单图片用的画布，不显示出来 -->
<canvas type="2d" id="ticket-canvas" class="ticket-canvas"></canvas>
