.today {
  padding: 24rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
}

.today-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.clear {
  color: var(--wood);
}

/* ---------- 买菜清单 ---------- */

.shopping {
  margin: 8rpx 0 40rpx;
}

.shopping-head {
  display: flex;
  align-items: center;
}

.shopping-title {
  flex: 1;
  display: flex;
  align-items: center;
  font-size: var(--fs-title);
  font-weight: 700;
}

.shop-copy {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  padding: 6rpx 18rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  font-size: var(--fs-small);
  color: var(--text-2);
}

.shopping-progress {
  font-size: 24rpx;
  color: var(--scallion);
}

.shopping-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}

.shop-group {
  margin-top: 20rpx;
}

.shop-label {
  padding-bottom: 6rpx;
  font-size: 24rpx;
  color: var(--wood);
}

.shop-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.shop-all {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--wood);
  text-decoration: underline;
}

.shop-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border: 3rpx solid #d9cfc1;
  border-radius: 50%;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #fff;
}

.shop-row.done .check {
  border-color: var(--scallion);
  background: var(--scallion);
}

.shop-main {
  flex: 1;
  min-width: 0;
}

.shop-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.shop-name {
  font-size: 28rpx;
}

.shop-amount {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.shop-dishes {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.shop-flag {
  margin-right: 10rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #fde4dc;
  color: var(--danger);
}

/* 买到了：变淡、划掉 */
.shop-row.done .shop-name,
.shop-row.done .shop-amount {
  color: var(--text-3);
  text-decoration: line-through;
}

/* 右边的小按钮：家里有 / 用完了 */
.shop-act {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  font-size: 22rpx;
  color: var(--text-2);
}

.shop-remove {
  flex-shrink: 0;
  width: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--text-3);
}

.shop-add {
  padding: 20rpx 0 4rpx;
  font-size: 26rpx;
  color: var(--wood);
}

/* 家里有的 */
.stock-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--line);
  font-size: 26rpx;
  color: var(--text-2);
}

.stock-name {
  flex: 1;
}

.stock-amount {
  font-size: 24rpx;
  color: var(--text-3);
}

.pantry-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--wood);
}
