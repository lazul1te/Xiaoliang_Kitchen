<view wx:if="{{form}}" class="wish-edit">
  <view class="photo-box" bindtap="onChoosePhoto" hover-class="tap-card" hover-stay-time="100">
    <cloud-image wx:if="{{form.photo}}" class="photo" src="{{form.photo}}" mode="aspectFill" />
    <view wx:else class="photo-empty">
      <image class="ic xl" src="/images/icons/camera-wood.png" />
      <text>加一张图（拍照、截图都行）</text>
    </view>
    <view wx:if="{{form.photo}}" class="photo-actions">
      <view class="photo-btn">换一张</view>
      <view class="photo-btn" catchtap="onRemovePhoto" hover-class="tap" hover-stay-time="100" hover-stop-propagation>删除</view>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">菜名</text>
      <input class="input" value="{{form.name}}" placeholder="比如：酸菜鱼" maxlength="20" data-field="name" bindinput="onInput" />
    </view>
    <view class="note-label">备注</view>
    <textarea class="text-input" value="{{form.note}}" placeholder="在哪吃到的、哪个视频教程、想怎么做……"
              auto-height maxlength="-1" cursor-spacing="80" data-field="note" bindinput="onInput" />
  </view>

  <view wx:if="{{isEdit}}" class="learn" bindtap="onLearn" hover-class="tap" hover-stay-time="100">开始学：写成菜谱 ›</view>
</view>

<view wx:if="{{form}}" class="save-bar">
  <view wx:if="{{isEdit}}" class="delete-btn" bindtap="onDelete" hover-class="tap" hover-stay-time="100">删除</view>
  <view class="btn-primary save-btn" bindtap="onSave" hover-class="tap" hover-stay-time="100">保存</view>
</view>
