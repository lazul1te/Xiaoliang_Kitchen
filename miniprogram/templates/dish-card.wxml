<!--
  菜品卡片：菜单页、搜索结果、今日页共用。用法：
    <import src="/templates/dish-card.wxml" />
    <template is="dishCard" data="{{dish: item, basket: basket, broken: broken}}" />
  dish 是 utils/dish.js 里 toCard() 的结果，basket 是菜篮 { 菜品id: 份数 }，
  broken 是加载失败的照片 { 照片地址: true }，显示占位图（换了新照片会重新加载）。
  照片用 cloud-image 组件显示（components/cloud-image），家人传的照片也看得到。
  点击事件 onOpenDish / onPlus / onMinus / onCoverError 由使用它的页面提供；样式在 app.wxss。
-->
<template name="dishCard">
  <view class="dish-card {{basket[dish._id] > 0 ? 'picked' : ''}}" data-id="{{dish._id}}" bindtap="onOpenDish">
    <cloud-image wx:if="{{dish.cover && !broken[dish.cover]}}" class="cover" src="{{dish.cover}}" mode="aspectFill"
           data-src="{{dish.cover}}" binderror="onCoverError" />
    <view wx:else class="cover cover-placeholder">{{dish.initial}}</view>
    <view class="dish-info">
      <view class="dish-name">{{dish.name}}</view>
      <view class="dish-meta">{{dish.meta}}</view>
      <view class="dish-foot">
        <view class="badge {{dish.statusClass}}">{{dish.statusText}}</view>
        <text class="dish-cook">{{dish.cookText}}</text>
        <view class="stepper">
          <block wx:if="{{basket[dish._id] > 0}}">
            <view class="stepper-btn minus" data-id="{{dish._id}}" catchtap="onMinus">−</view>
            <text class="stepper-num">{{basket[dish._id]}}</text>
          </block>
          <view class="stepper-btn plus" data-id="{{dish._id}}" catchtap="onPlus">+</view>
        </view>
      </view>
    </view>
  </view>
</template>
