<!--
  一顿饭的卡片（开饭时一起记的）：整桌照片、哪一顿、点菜单编号、每道菜的分数、心得。点菜单记录页用（记录页还是一道菜一条）。用法：
    <import src="/templates/meal-card.wxml" />
    <template is="mealCard" data="{{...卡片}}" />     卡片是 utils/meal.js 的 mealCard()
  用到它的页面要有 onOpenLog（点一道菜，看那条做菜记录）、onReorder（再来一单）、onShareMeal（分享这顿饭）、onEditMeal（改一改），
  data-id 是这一顿（或者那条记录）的 _id。样式在 app.wxss。
-->
<template name="mealCard">
  <view class="meal-card">
    <cloud-image wx:if="{{photo}}" class="meal-photo" src="{{photo}}" mode="aspectFill" />
    <view class="meal-body">
      <view class="meal-head">
        <text class="meal-title">{{title}}</text>
        <text wx:if="{{noText}}" class="meal-no">{{noText}}</text>
        <text wx:if="{{peopleText}}" class="meal-people">{{peopleText}}</text>
      </view>
      <view wx:for="{{dishes}}" wx:key="_id" class="meal-dish" data-id="{{item._id}}" bindtap="onOpenLog" hover-class="tap-row" hover-stay-time="100">
        <view class="meal-dish-main">
          <text class="meal-dish-name">{{item.dishName}}<text wx:if="{{item.qtyText}}" class="meal-qty"> {{item.qtyText}}</text></text>
          <text wx:if="{{item.note}}" class="meal-dish-note">{{item.note}}</text>
        </view>
        <text wx:if="{{item.stars}}" class="meal-stars">{{item.stars}}</text>
      </view>
      <view wx:if="{{note}}" class="meal-note">{{note}}</view>
      <view class="meal-acts">
        <view class="pill pri meal-act" data-id="{{_id}}" bindtap="onReorder" hover-class="tap" hover-stay-time="100">再来一单</view>
        <view class="pill meal-act" data-id="{{_id}}" bindtap="onShareMeal" hover-class="tap" hover-stay-time="100">分享这顿饭</view>
        <view class="pill meal-act" data-id="{{_id}}" bindtap="onEditMeal" hover-class="tap" hover-stay-time="100">改一改</view>
      </view>
    </view>
  </view>
</template>
